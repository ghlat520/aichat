.app-tabbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; display: flex; align-items: center; padding: 10rpx 15rpx calc(17rpx + env(safe-area-inset-bottom)); background: #ffffff; border-top: 1rpx solid #edf0f6; }
.app-tabbar .app-tab { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; width: auto; min-width: 0; min-height: 108rpx; margin: 0; padding: 0; background: transparent; color: #69778c; font-size: 20rpx; font-weight: 400; line-height: 1.5; }
.app-tab::after { border: 0; }
.app-tab-icon { display: flex; justify-content: center; align-items: center; width: 72rpx; height: 60rpx; margin-bottom: 8rpx; border-radius: 20rpx; }
.app-tab-icon .ui-icon { width: 44rpx; height: 44rpx; filter: grayscale(1); opacity: .8; }
.app-tabbar .app-tab--active { color: var(--ui-brand, #3155d9); font-weight: 600; }
.app-tab--active .ui-icon { filter: none; opacity: 1; }
.app-tabbar .app-tab--talk { margin-top: 0; padding-top: 0; }
.app-tab--talk .app-talk-orb { box-sizing: border-box; width: 72rpx; height: 60rpx; margin-bottom: 8rpx; border: 0; border-radius: 20rpx; background: transparent; box-shadow: none; }
.app-talk-orb .ui-icon { width: 44rpx; height: 44rpx; filter: grayscale(1); opacity: .8; }

.app-tab--active .app-tab-icon, .app-tab--active .app-talk-orb { background: var(--ui-blue, #e8eeff); }
.app-tab--active .app-talk-orb .ui-icon { filter: none; opacity: 1; }
