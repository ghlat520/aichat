<view class="app-tabbar">
  <button wx:for="{{tabs}}" wx:key="path" class="app-tab {{selected === index ? 'app-tab--active' : ''}} {{item.icon === 'chat-light' ? 'app-tab--talk' : ''}}" data-index="{{index}}" bindtap="switchTab" aria-label="{{item.label}}" id="app-tab-{{index}}">
    <view class="app-tab-icon {{item.icon === 'chat-light' ? 'app-talk-orb' : ''}}"><view class="ui-icon ui-icon--{{item.icon}}"></view></view><text class="app-tab-label">{{item.label}}</text>
  </button>
</view>
