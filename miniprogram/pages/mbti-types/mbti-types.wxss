/* MBTI 16 型优缺点（2026-11-03 原型 V2 mbti-types 屏，px×2→rpx）*/
.te-intro { margin: 36rpx 0 44rpx; }
.te-intro-title { font-size: 50rpx; font-weight: 550; line-height: 1.7; letter-spacing: -1rpx; margin-top: 30rpx; }
.te-intro-copy { font-size: 24rpx; line-height: 1.9; color: #91a0b6; margin-top: 22rpx; }
.te-modes { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin: 42rpx 0 24rpx; }
.te-mode { padding: 22rpx; border: 1rpx solid var(--ui-line, #e9edf5); border-radius: 20rpx; color: #96a1b7; background: #ffffff; font-size: 24rpx; margin: 0; line-height: 1.6; }
.te-mode::after { border: 0; }
.te-mode--selected { background: #eaf0fc; border-color: #c9d4ee; color: #6a7fb6; }
.te-guidance { font-size: 20rpx; color: #96a3b8; line-height: 1.95; margin: 26rpx 0 40rpx; }
.te-select { font-size: 22rpx; line-height: 1.9; color: #8c99b2; display: block; }
.te-select-value { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 84rpx; margin-top: 16rpx; border: 1rpx solid #e0e6f2; background: #ffffff; border-radius: 20rpx; padding: 18rpx 22rpx; color: #7588b1; font-size: 24rpx; box-sizing: border-box; }
.te-select-arrow { color: #a5afc0; margin-left: 12rpx; }
.te-groups { display: flex; gap: 10rpx; flex-wrap: wrap; margin: 30rpx 0; }
.te-chip { font-size: 20rpx; color: #9ba6ba; background: #ffffff; border: 1rpx solid var(--ui-line, #e9edf5); border-radius: 16rpx; padding: 14rpx 16rpx; line-height: 1.8; margin: 0; }
.te-chip::after { border: 0; }
.te-chip--selected { color: #7184b7; background: #edf1fc; border-color: #d0d9ef; }
.te-note { font-size: 20rpx; color: #96a3b8; line-height: 1.95; margin: 26rpx 0 40rpx; }
.te-count { font-size: 20rpx; color: #9aa7bb; margin: 38rpx 0 22rpx; }
.te-list { display: grid; gap: 34rpx; }
.te-card { padding: 44rpx 36rpx; background: #ffffff; border: 1rpx solid var(--ui-line, #e9edf5); border-radius: 34rpx; }
.te-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; padding-bottom: 34rpx; border-bottom: 1rpx solid var(--ui-line, #e9edf5); }
.te-card-code { font-size: 46rpx; font-weight: 550; letter-spacing: 2rpx; color: #7488b9; line-height: 1.5; }
.te-card-name { font-size: 26rpx; letter-spacing: 0; color: #8290a9; margin-left: 10rpx; }
.te-card-alias { font-size: 20rpx; color: #9ca7bb; margin-top: 14rpx; line-height: 1.8; }
.te-card-badge { flex-shrink: 0; white-space: nowrap; font-size: 20rpx; line-height: 1.8; }
.te-sub-title { font-size: 24rpx; font-weight: 500; line-height: 1.9; margin: 36rpx 0 20rpx; }
.te-sub-title--up { color: #7d9f98; }
.te-sub-title--dn { color: #9a8cae; }
.te-point { font-size: 24rpx; line-height: 1.95; color: #8694ab; padding-left: 32rpx; margin-bottom: 14rpx; overflow-wrap: anywhere; position: relative; }
.te-point--up::before { content: '·'; position: absolute; left: 10rpx; color: #a2c3ba; }
.te-point--dn::before { content: '·'; position: absolute; left: 10rpx; color: #b5a9c8; }
.te-card-foot { display: flex; justify-content: space-between; gap: 24rpx; border-top: 1rpx solid var(--ui-line, #e9edf5); padding-top: 32rpx; margin-top: 40rpx; }
.te-link { font-size: 22rpx; line-height: 1.8; color: #6577dc; background: transparent; padding: 0; margin: 0; }
.te-link::after { border: 0; }
