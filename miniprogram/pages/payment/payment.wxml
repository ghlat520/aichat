<view class="container gk-screen">
  <view class="gk-head">
    <button class="ui-back" bindtap="goBack" aria-label="返回"><view class="ui-icon ui-icon--back"></view></button>
    <view class="gk-head-title">购买结果</view>
    <text class="gk-head-tag">订单状态</text>
  </view>

  <view class="gk-payment-state">
    <view class="gk-state-icon {{view.cls === 'wait' ? 'gk-state-icon--wait' : view.cls === 'failure' ? 'gk-state-icon--failure' : ''}}">{{view.icon}}</view>
    <view class="gk-payment-state-title">{{view.title}}</view>
    <view wx:for="{{descLines}}" wx:key="*this" class="payment-desc-line">{{item}}</view>
  </view>

  <view class="gk-card">
    <view class="gk-price-line"><text>商品</text><text>{{productLabel}}</text></view>
    <view class="gk-price-line"><text>{{upgradeLabel}}</text><text>¥{{amount}}</text></view>
    <view class="gk-price-line"><text>订单</text><text>演示订单 {{orderId}}</text></view>
    <view class="gk-price-line"><text>交付</text><text>{{deliveryText}}</text></view>
  </view>

  <button wx:if="{{payment === 'success'}}" class="gk-primary" bindtap="viewReport">查看我的完整报告</button>
  <button wx:if="{{payment === 'pending'}}" class="gk-primary" bindtap="queryOrder">查询这笔订单</button>
  <button wx:if="{{payment === 'delivery'}}" class="gk-primary" bindtap="goOrder">查看交付与售后进度</button>
  <button wx:if="{{payment === 'cancel' || payment === 'failed'}}" class="gk-primary" bindtap="backToCheckout">返回购买确认</button>

  <button class="gk-secondary" bindtap="goReports">回到我的结果</button>
  <view wx:if="{{payment === 'pending'}}" class="gk-footer-note">正在确认支付，请勿重复付款。</view>
</view>
