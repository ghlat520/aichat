.insight-title { margin: 40rpx 0 10rpx; font-size: 44rpx; line-height: 1.6; letter-spacing: -1.2rpx; font-weight: 550; }
.insight-lead { margin: 20rpx 0 40rpx; }
.insight-card { margin-top: 20rpx; }
.insight-fact { margin-top: 24rpx; }
.insight-source { display: flex; gap: 14rpx; align-items: center; padding: 22rpx 0 0; font-size: 20rpx; color: #8594b1; line-height: 1.8; text-align: left; width: 100%; background: transparent; }
.insight-source::after { border: 0; }
.insight-source-icon { width: 28rpx; height: 28rpx; }
.insight-observation { font-size: 22rpx; line-height: 1.9; color: #7e8ba4; margin-top: 30rpx; }
.insight-observation-text { margin-top: 16rpx; }
.insight-observation-note { margin-top: 26rpx; }
.insight-bridge { background: #edf5f6; border: 1rpx solid #e3efed; padding: 40rpx; border-radius: 34rpx; margin: 36rpx 0; }
.insight-bridge .gk-feature-icon { height: 76rpx; width: 76rpx; }
.insight-bridge-title { font-size: 36rpx; letter-spacing: -.8rpx; font-weight: 550; margin: 26rpx 0 18rpx; }
.insight-bridge-copy { font-size: 22rpx; color: #829c99; line-height: 1.9; margin-bottom: 12rpx; }
.insight-br { display: block; height: 0; }
