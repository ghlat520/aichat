.exp-br { display: block; height: 0; }
.exp-tabs { display: flex; gap: 10rpx; background: #edf1f8; padding: 8rpx; border-radius: 22rpx; margin: 34rpx 0; }
.exp-tab { flex: 1; font-size: 22rpx; padding: 18rpx 10rpx; color: #9aa5b9; border-radius: 16rpx; background: transparent; line-height: 1.5; }
.exp-tab::after { border: 0; }
.exp-tab--selected { background: #ffffff; color: #6d7fbd; box-shadow: 0 4rpx 10rpx #52658212; }
.exp-stepper { display: flex; gap: 26rpx; margin: 38rpx 0; }
.exp-step { flex: 1; display: flex; gap: 16rpx; align-items: center; font-size: 22rpx; color: #a6afc0; background: transparent; padding: 8rpx 0; }
.exp-step::after { border: 0; }
.exp-step-dot { width: 46rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; background: #edf0f7; border-radius: 50%; color: #b5bdcd; font-size: 22rpx; }
.exp-step--selected { color: #7c8dc3; }
.exp-step--selected .exp-step-dot { background: #e3e9fc; color: #7689c4; }
.exp-prompt-chips .gk-chip { font-size: 20rpx; padding: 14rpx 16rpx; }
.exp-prompt-hint { margin-top: 20rpx; }
.exp-card { padding: 34rpx; background: #ffffff; border: 1rpx solid #e6eaf3; border-radius: 34rpx; margin: 36rpx 0; }
.exp-card-hint { margin-top: 18rpx; }
.exp-index { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: var(--ui-blue); color: var(--ui-brand); font-size: 22rpx; }
.exp-energy-toggle { font-size: 20rpx; color: #95a4ba; line-height: 1.9; margin-bottom: 24rpx; padding: 10rpx 0 0; background: transparent; text-align: left; width: 100%; }
.exp-energy-toggle::after { border: 0; }
.exp-goal-label { margin-top: 46rpx; }
