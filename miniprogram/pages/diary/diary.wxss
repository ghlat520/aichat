.diary-preview-note { color: #7a8599; font-size: 21rpx; line-height: 1.8; padding: 18rpx 22rpx; border-radius: 18rpx; background: #eef2f9; margin: 4rpx 0 30rpx; }
.diary-heading { font-size: 40rpx; font-weight: 550; line-height: 1.55; letter-spacing: -1rpx; margin-top: 26rpx; }
.diary-line-break { display: block; }
.diary-heading-note { color: var(--ui-muted); font-size: 23rpx; margin-top: 12rpx; }
.diary-panels { display: flex; border-bottom: 1rpx solid #e1e7f1; margin: 26rpx 0 22rpx; gap: 36rpx; }
.diary-panels .diary-panel { width: auto; padding: 20rpx 0; margin: 0 0 -1rpx; font-size: 25rpx; font-weight: 400; line-height: 1.6; color: var(--ui-muted); background: transparent; border-radius: 0; border-bottom: 4rpx solid transparent; }
.diary-panel::after,.diary-page button::after { border: 0; }
.diary-panels .diary-panel--active { color: var(--ui-brand); border-bottom-color: var(--ui-brand); font-weight: 550; }
.diary-view-switch { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.diary-view-label { font-size: 22rpx; color: var(--ui-muted); }
.diary-tree-card { background: #ffffff; border: 1rpx solid var(--ui-line); border-radius: 32rpx; padding: 28rpx 25rpx 24rpx; }
.diary-tree-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.diary-tree-title { font-size: 28rpx; font-weight: 550; }
.diary-tree-sub { font-size: 20rpx; color: var(--ui-muted); margin-top: 6rpx; }
.diary-day-count { color: #85979f; font-size: 41rpx; font-weight: 500; display: flex; flex-direction: column; align-items: center; line-height: 1.2; }
.diary-day-count text { color: var(--ui-muted); font-size: 17rpx; margin-top: 8rpx; font-weight: 400; }
.diary-tree-stage { position: relative; height: 490rpx; margin: 20rpx -8rpx 0; }
.diary-tree-art { position: absolute; inset: 0; background-size: 100% 100%; background-position: center; background-repeat: no-repeat; }
.diary-tree-stage .diary-branch { position: absolute; width: auto; min-width: 110rpx; margin: 0; padding: 7rpx 10rpx; border-radius: 12rpx; font-size: 19rpx; line-height: 1.6; color: #65738a; background: #ffffffee; border: 1rpx solid transparent; font-weight: 400; }
.diary-branch text { font-size: 18rpx; }
.diary-tree-stage .diary-branch--selected { border-color: #dde5f0; background: #f5f8fc; }
.diary-branch--emotion { left: 0; top: 67%; }
.diary-branch--relationship { right: 0; top: 70%; }
.diary-branch--needs { left: 0; top: 34%; }
.diary-branch--action { right: 0; top: 36%; }
.diary-branch--thinking { left: 10%; top: 0; }
.diary-branch--meaning { right: 4%; top: 0; }
.diary-tree-caption { color: var(--ui-muted); font-size: 19rpx; line-height: 1.8; text-align: center; }
.diary-branch-detail { padding: 30rpx 6rpx; border-bottom: 1rpx solid var(--ui-line); }
.diary-branch-detail-heading { display: flex; align-items: center; gap: 12rpx; font-size: 25rpx; font-weight: 500; }
.diary-focus-dot { width: 14rpx; height: 14rpx; border-radius: 50%; flex-shrink: 0; }
.diary-branch-count { margin-left: auto; color: var(--ui-muted); font-size: 19rpx; font-weight: 400; }
.diary-branch-prompt { color: #65738a; font-size: 24rpx; line-height: 1.85; margin: 20rpx 0 14rpx; }
.diary-week { display: flex; align-items: center; gap: 20rpx; margin: 24rpx 0 30rpx; }
.diary-week-label { color: var(--ui-muted); font-size: 20rpx; white-space: nowrap; }
.diary-week-days { display: flex; flex: 1; justify-content: space-between; }
.diary-week-day { font-size: 21rpx; text-align: center; color: #9ca7b9; min-width: 35rpx; }
.diary-week-dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: #e2e8f0; margin: 9rpx auto 0; }
.diary-week-day--recorded { color: #69968a; }
.diary-week-day--recorded .diary-week-dot { background: #8ab6ac; }
.diary-soft-note { color: var(--ui-muted); font-size: 21rpx; text-align: center; line-height: 1.9; margin: 22rpx 0; }
.diary-editor-intro { font-size: 35rpx; line-height: 1.7; margin: 32rpx 0 25rpx; }
.diary-date-picker { display: flex; justify-content: space-between; align-items: center; padding-bottom: 22rpx; border-bottom: 1rpx solid var(--ui-line); color: #687891; font-size: 24rpx; }
.diary-date-picker text { color: var(--ui-brand); font-size: 21rpx; }
.diary-field-title { font-size: 25rpx; font-weight: 500; margin: 30rpx 0 18rpx; }
.diary-field-title > text { display: block; color: var(--ui-muted); font-size: 20rpx; font-weight: 400; margin-top: 6rpx; }
.diary-moods { display: flex; gap: 12rpx; margin-bottom: 26rpx; }
.diary-moods .diary-mood { display: flex; flex: 1; flex-direction: column; align-items: center; gap: 9rpx; min-width: 0; width: auto; background: #ffffff; border: 1rpx solid var(--ui-line); padding: 17rpx 4rpx; border-radius: 18rpx; font-size: 21rpx; font-weight: 400; color: #78859b; line-height: 1.7; }
.diary-moods .diary-mood--selected { border-color: #afbce5; background: #eef1ff; color: #5e70b5; }
.diary-mood-dot { height: 27rpx; width: 27rpx; border-radius: 50%; box-shadow: inset 0 0 0 6rpx #ffffff55; }
.diary-writing-paper { background: #ffffff; border: 1rpx solid #e0e6f0; border-radius: 24rpx; padding: 24rpx; }
.diary-textarea { width: 100%; min-height: 310rpx; height: 360rpx; font-size: 27rpx; color: var(--ui-ink); line-height: 1.95; box-sizing: border-box; }
.diary-placeholder { color: #9aa6ba; }
.diary-word-count { color: #98a3b6; text-align: right; font-size: 19rpx; margin-top: 12rpx; }
.diary-dimensions { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.diary-dimensions .diary-dimension { width: 100%; display: flex; justify-content: space-between; align-items: center; box-sizing: border-box; margin: 0; padding: 19rpx 22rpx; background: #ffffff; border: 1rpx solid #e1e7f1; color: #7a869b; font-size: 23rpx; font-weight: 400; line-height: 1.6; border-radius: 18rpx; }
.diary-dimensions .diary-dimension--selected { background: #eef4f2; border-color: #bfd8d1; color: #5e8e83; }
.diary-dimension-check { font-size: 25rpx; }
.diary-writing-prompt { color: var(--ui-muted); font-size: 22rpx; line-height: 1.85; margin: 24rpx 0 30rpx; }
.diary-empty { text-align: center; padding: 76rpx 0 65rpx; }
.diary-empty .ui-icon { width: 75rpx; height: 75rpx; margin: 0 auto 26rpx; opacity: .75; }
.diary-empty-title { font-size: 36rpx; font-weight: 500; margin-bottom: 18rpx; }
.diary-empty-copy { color: var(--ui-muted); font-size: 24rpx; line-height: 1.9; }
.diary-entry-list { border-top: 1rpx solid var(--ui-line); }
.diary-entry-list .diary-entry { box-sizing: border-box; width: 100%; margin: 0; border-radius: 0; padding: 30rpx 4rpx; border-bottom: 1rpx solid #e1e7f1; text-align: left; font-size: 25rpx; line-height: 1.8; font-weight: 400; background: transparent; color: var(--ui-ink); }
.diary-entry-heading { display: flex; justify-content: space-between; align-items: center; font-size: 25rpx; }
.diary-entry-mood { display: flex; align-items: center; gap: 10rpx; color: var(--ui-muted); font-size: 21rpx; }
.diary-entry-excerpt { font-size: 25rpx; line-height: 1.9; color: #65738a; margin: 18rpx 0; overflow-wrap: anywhere; }
.diary-entry-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.diary-entry-tags text { font-size: 19rpx; color: #7c8ba2; background: #edf1f7; padding: 4rpx 12rpx; border-radius: 8rpx; }
.diary-entry-detail { background: #ffffff; padding: 30rpx 28rpx; border-radius: 26rpx; border: 1rpx solid var(--ui-line); }
.diary-entry-detail-date { font-size: 37rpx; font-weight: 500; margin: 32rpx 0 10rpx; }
.diary-entry-body { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 28rpx; line-height: 2; margin: 32rpx 0; }
.diary-entry-detail .gk-secondary { margin-top: 30rpx; }
.diary-letter-notice { color: #897b9d; font-size: 21rpx; line-height: 1.8; margin: 25rpx 0; }
.diary-letter { position: relative; background: #ffffff; padding: 40rpx 30rpx; border: 1rpx solid #e3e7f0; border-radius: 8rpx 8rpx 28rpx 28rpx; margin: 10rpx 0 30rpx; }
.diary-letter::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 5rpx; background: #bdc8da; border-radius: 8rpx 8rpx 0 0; }
.diary-letter-symbol .ui-icon { width: 46rpx; height: 46rpx; margin: 0 auto; }
.diary-letter-title { text-align: center; font-size: 39rpx; line-height: 1.65; font-weight: 500; letter-spacing: 1rpx; margin: 22rpx 0 18rpx; }
.diary-letter-source { font-size: 19rpx; color: #9aa5b5; text-align: center; margin-bottom: 40rpx; }
.diary-letter-paragraph { color: #536079; font-size: 27rpx; line-height: 2.1; margin-bottom: 27rpx; }
.diary-letter-signature { text-align: right; color: #6b7e96; font-size: 24rpx; line-height: 1.9; margin-top: 38rpx; }
.diary-letter-signature > text:last-child { color: #9aa5b5; font-size: 19rpx; }
