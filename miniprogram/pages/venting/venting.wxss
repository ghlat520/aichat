.venting-intro { display: flex; align-items: center; gap: 24rpx; padding: 36rpx; background: #ffffff; border: 1rpx solid var(--ui-line); border-radius: 36rpx; margin-bottom: 24rpx; }
.venting-avatar { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 88rpx; height: 88rpx; background: var(--ui-aqua); border-radius: 28rpx; }
.venting-avatar .ui-icon { width: 42rpx; height: 42rpx; }
.venting-intro-title { font-size: 28rpx; font-weight: 600; }
.venting-intro-note { font-size: 20rpx; color: var(--ui-muted); }
.venting-bubble { box-sizing: border-box; max-width: 91%; white-space: pre-wrap; overflow-wrap: anywhere; padding: 30rpx; font-size: 24rpx; line-height: 1.9; color: var(--ui-ink); background: #ffffff; border-radius: 8rpx 30rpx 30rpx 30rpx; margin: 34rpx 0; }
.venting-message-row { display: flex; }
.venting-message-row--user { justify-content: flex-end; }
.venting-bubble--user { background: #e7ebfb; border-radius: 30rpx 8rpx 30rpx 30rpx; }
.venting-composer { display: flex; align-items: flex-end; gap: 18rpx; margin-top: 44rpx; }
.venting-input { flex: 1; min-width: 0; width: auto; min-height: 134rpx; max-height: 240rpx; padding: 24rpx; border: 1rpx solid var(--ui-line); border-radius: 24rpx; background: #ffffff; font-size: 24rpx; line-height: 1.8; box-sizing: border-box; color: var(--ui-ink); }
.venting-composer .venting-send { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 78rpx; height: 78rpx; margin: 0; padding: 0; background: var(--ui-brand); color: #ffffff; border-radius: 22rpx; font-size: 35rpx; line-height: 1; font-weight: 400; }
.venting-send::after,.venting-finish::after { border: 0; }
.venting-send[disabled] { opacity: .45; }
.venting-finish { width: auto; margin: 21rpx auto; padding: 10rpx 18rpx; color: var(--ui-brand); background: transparent; font-size: 23rpx; font-weight: 400; line-height: 1.6; }
.practice-page { color: #304057; padding-bottom: 200rpx; }
.practice-mode { display: flex; align-items: center; justify-content: space-between; margin: 12rpx 0 20rpx; padding: 0 4rpx; font-size: 23rpx; color: #65758b; }
.practice-mode button { margin: 0; min-height: 88rpx; padding: 20rpx 0 20rpx 20rpx; border-radius: 0; background: transparent; font-size: 24rpx; line-height: 48rpx; color: #466fa7; }
.practice-mode button::after, .practice-light-flow button::after, .practice-deep-flow button::after, .practice-expand::after, .practice-online-link::after, .practice-inline::after, .practice-source button::after { border: 0; }
.practice-light-flow { display: flex; align-items: center; justify-content: space-between; padding: 4rpx 8rpx; background: #edf3fb; border-radius: 18rpx; margin-bottom: 32rpx; }
.practice-light-flow button { background: transparent; color: #697a91; font-size: 25rpx; line-height: 48rpx; min-height: 88rpx; padding: 20rpx 12rpx; margin: 0; border-radius: 14rpx; }
.practice-light-flow > text { font-size: 27rpx; color: #9baec7; }
.practice-light-flow .practice-flow-active { color: #355c8d; font-weight: 600; background: #fff; box-shadow: 0 4rpx 12rpx #dfe8f5; }
.practice-deep-flow { display: flex; justify-content: space-between; gap: 8rpx; margin-bottom: 36rpx; }
.practice-deep-flow button { flex: 1; margin: 0; padding: 16rpx 0; min-height: 104rpx; border-radius: 14rpx; background: #eef3fa; color: #637896; font-size: 23rpx; line-height: 1.5; }
.practice-deep-flow button > text { display: block; font-size: 20rpx; opacity: .65; }
.practice-deep-flow .practice-flow-active { background: #dbe8fc; color: #335f9c; font-weight: 600; }
.practice-deep-flow .practice-stage-disabled { background: #f4f6f9; color: #a2adbc; }
.practice-hero { position: relative; display: flex; align-items: flex-start; margin-bottom: 36rpx; min-height: 280rpx; }
.practice-hero-copy { flex: 1; z-index: 1; padding-top: 12rpx; }
.practice-eyebrow { color: #697d99; font-size: 22rpx; letter-spacing: 1rpx; margin-bottom: 16rpx; }
.practice-title { max-width: 470rpx; font-size: 47rpx; font-weight: 600; letter-spacing: -1rpx; line-height: 1.4; color: #2c3f59; white-space: pre-line; }
.practice-description { font-size: 27rpx; line-height: 1.75; color: #687a91; margin-top: 18rpx; max-width: 450rpx; }
.practice-hero-art { width: 200rpx; height: 210rpx; flex: 0 0 200rpx; margin: 18rpx -12rpx 0 -28rpx; background-position: center; background-size: contain; background-repeat: no-repeat; }
.practice-field { margin-bottom: 30rpx; }
.practice-field-label, .practice-field-heading { color: #364d6a; font-size: 29rpx; line-height: 1.65; font-weight: 500; margin-bottom: 14rpx; }
.practice-field-label > text { font-size: 22rpx; color: #8190a5; font-weight: 400; margin-left: 12rpx; }
.practice-field-input { display: block; width: 100%; box-sizing: border-box; min-height: 168rpx; padding: 24rpx; font-size: 28rpx; line-height: 1.8; color: #304258; background: #fff; border: 1rpx solid #dce4ef; border-radius: 18rpx; }
.practice-field-input--when { min-height: 112rpx; }
.practice-placeholder { color: #8a97a9; }
.practice-expand { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 100rpx; padding: 20rpx 0; margin: 8rpx 0 24rpx; background: transparent; border-bottom: 1rpx solid #e0e7f0; border-radius: 0; font-size: 25rpx; color: #536c8d; text-align: left; }
.practice-expand > text + text { font-size: 23rpx; color: #7c8ca3; }
.practice-extra-body { padding-top: 6rpx; }
.practice-source { display: block; width: 100%; text-align: left; padding: 20rpx 24rpx; margin-bottom: 32rpx; border-radius: 18rpx; border-left: 5rpx solid #91b9aa; background: #eef8f3; }
.practice-card-kicker, .practice-quote > text, .practice-current-action > text { display: block; color: #6a7f87; font-size: 23rpx; margin-bottom: 12rpx; }
.practice-action-card { padding: 36rpx 30rpx; background: #eaf3ff; border: 1rpx solid #d5e4f8; border-radius: 24rpx; margin-bottom: 34rpx; }
.practice-action-title { font-size: 35rpx; line-height: 1.65; font-weight: 500; color: #305681; white-space: pre-wrap; }
.practice-action-detail { border-top: 1rpx dashed #bccfe8; margin-top: 26rpx; padding-top: 22rpx; }
.practice-action-detail > text { font-size: 23rpx; color: #6c85a5; }
.practice-action-detail > view { font-size: 28rpx; line-height: 1.8; margin-top: 8rpx; color: #3b5c85; white-space: pre-wrap; }
.practice-current-action { padding: 24rpx; background: #fff0e5; border-radius: 18rpx; margin-bottom: 32rpx; }
.practice-current-action > view { font-size: 28rpx; line-height: 1.8; color: #8b5a39; white-space: pre-wrap; }
.practice-quote { margin-bottom: 26rpx; padding: 0 0 0 22rpx; border-left: 4rpx solid #ccdbee; }
.practice-quote > view { font-size: 28rpx; line-height: 1.8; color: #405671; white-space: pre-wrap; }
.practice-goals, .practice-outcomes { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 28rpx; }
.practice-goals button, .practice-outcomes button { flex: 1; min-width: 180rpx; min-height: 94rpx; padding: 22rpx 14rpx; margin: 0; border: 1rpx solid #dce5f0; border-radius: 16rpx; background: #fff; font-size: 25rpx; line-height: 1.8; color: #667d9b; }
.practice-goals button::after, .practice-outcomes button::after { border: 0; }
.practice-goals .practice-option-selected, .practice-outcomes .practice-option-selected { background: #e3edfc; border-color: #7ea2d8; color: #315e9d; font-weight: 500; }
.practice-feedback { padding: 28rpx; margin-bottom: 32rpx; background: #fff3e9; border-radius: 20rpx; }
.practice-feedback > view { color: #705d50; font-size: 28rpx; line-height: 1.85; margin-bottom: 22rpx; }
.practice-feedback .practice-card-kicker { color: #9a7251; }
.practice-evidence-note { display: block; color: #8b7b70; font-size: 23rpx; line-height: 1.7; }
.practice-pattern { padding: 24rpx; font-size: 26rpx; line-height: 1.8; color: #4d7893; background: #eaf5fb; border-radius: 16rpx; margin-bottom: 28rpx; }
.practice-check { padding: 24rpx; margin: 0 0 30rpx; background: #f0f7f3; border-radius: 16rpx; color: #557267; font-size: 25rpx; line-height: 1.9; }
.practice-check > text { display: block; font-weight: 500; margin-bottom: 8rpx; }
.practice-inline, .practice-online-link { min-height: 88rpx; padding: 20rpx 0; margin: 8rpx 0; background: transparent; font-size: 25rpx; color: #567ca9; text-align: left; }
.practice-helper, .practice-local-note { font-size: 23rpx; line-height: 1.8; color: #8190a4; margin: 22rpx 0; }
.practice-local-note { border-top: 1rpx solid #e5ebf2; padding-top: 28rpx; }
.practice-history > view { padding: 28rpx 0; border-bottom: 1rpx solid #e0e8f0; font-size: 26rpx; line-height: 1.8; color: #657a93; }
.practice-history > view > text { display: block; font-size: 28rpx; font-weight: 500; color: #3c5779; margin-bottom: 12rpx; }

.practice-source::after { border: 0; }
.practice-source .practice-source-head { display: flex; justify-content: space-between; align-items: center; font-size: 23rpx; color: #5d8277; line-height: 1.6; margin-bottom: 8rpx; }
.practice-source .practice-source-excerpt { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 26rpx; line-height: 1.8; color: #3b625a; }
