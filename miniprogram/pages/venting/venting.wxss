.venting-intro { display: flex; align-items: center; gap: 24rpx; padding: 36rpx; background: #ffffff; border: 1rpx solid var(--ui-line); border-radius: 36rpx; margin-bottom: 24rpx; }
.venting-avatar { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 88rpx; height: 88rpx; background: var(--ui-aqua); border-radius: 28rpx; }
.venting-avatar .ui-icon { width: 42rpx; height: 42rpx; }
.venting-intro-title { font-size: 28rpx; font-weight: 600; }
.venting-intro-note { font-size: 20rpx; color: var(--ui-muted); }
.venting-bubble { box-sizing: border-box; max-width: 91%; white-space: pre-wrap; overflow-wrap: anywhere; padding: 30rpx; font-size: 24rpx; line-height: 1.9; color: var(--ui-ink); background: #ffffff; border-radius: 8rpx 30rpx 30rpx 30rpx; margin: 34rpx 0; }
.venting-message-row { display: flex; }
.venting-message-row--user { justify-content: flex-end; }
.venting-bubble--user { background: #e7ebfb; border-radius: 30rpx 8rpx 30rpx 30rpx; }
.venting-composer { display: flex; align-items: flex-end; gap: 18rpx; margin-top: 44rpx; }
.venting-input { flex: 1; min-width: 0; width: auto; min-height: 134rpx; max-height: 240rpx; padding: 24rpx; border: 1rpx solid var(--ui-line); border-radius: 24rpx; background: #ffffff; font-size: 24rpx; line-height: 1.8; box-sizing: border-box; color: var(--ui-ink); }
.venting-composer .venting-send { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 78rpx; height: 78rpx; margin: 0; padding: 0; background: var(--ui-brand); color: #ffffff; border-radius: 22rpx; font-size: 35rpx; line-height: 1; font-weight: 400; }
.venting-send::after,.venting-finish::after { border: 0; }
.venting-send[disabled] { opacity: .45; }
.venting-finish { width: auto; margin: 21rpx auto; padding: 10rpx 18rpx; color: var(--ui-brand); background: transparent; font-size: 23rpx; font-weight: 400; line-height: 1.6; }
