<view class="container gk-screen">
  <view class="gk-head">
    <button class="ui-back" bindtap="goBack" aria-label="返回"><view class="ui-icon ui-icon--back"></view></button>
    <view class="gk-head-title">校准这份解读</view>
    <text class="gk-head-tag">本机练习</text>
  </view>

  <view class="gk-page-title">校准解读</view>
  <view class="gk-lead">记下不符合的描述，再补充一件实际发生的事。</view>

  <block wx:if="{{calibrated}}">
    <view class="gk-card">
      <text class="gk-tag gk-tag--aqua">已完成本次练习</text>
      <view class="gk-title-sm calibrate-done-title">这次补充的内容</view>
      <view class="gk-small">{{calibrationText || '这是你在本次练习里补充的内容。'}}</view>
      <view class="gk-tiny calibrate-done-note">原报告与测评分数保持原样。这份练习内容不会提交给人工，也不会生成新的已购报告。</view>
    </view>
    <button class="gk-primary" bindtap="openReport">回到原报告</button>
  </block>

  <block wx:else>
    <view wx:if="{{expired}}" class="gk-notice">本次 7 天服务已结束。报告仍可查看，内容错误与交付问题可从售后入口反馈。</view>

    <view class="gk-field">
      <view class="gk-field-label">想校准哪一部分？</view>
      <picker mode="selector" range="{{targets}}" value="{{targetIndex}}" bindchange="onTargetChange">
        <view class="gk-input calibrate-picker">{{targets[targetIndex]}}</view>
      </picker>
    </view>
    <view class="gk-field">
      <view class="gk-field-label">哪里不符合？实际情况是什么？</view>
      <textarea class="gk-textarea" value="{{text}}" placeholder="例如：我不是不喜欢团队交流，而是不适应没有准备的临时会议。" maxlength="800" bindinput="onTextinput" />
    </view>

    <view class="gk-soft-note">本页只作练习，不会提交给人工或改写已购报告。已购服务以原订单说明为准。</view>

    <button class="gk-primary" bindtap="submit" disabled="{{expired}}">完成这次校准练习</button>
    <button class="gk-secondary" bindtap="goBack">先回去读一读</button>
  </block>
</view>
