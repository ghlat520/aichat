.result-cover { border-radius: 42rpx; position: relative; background: linear-gradient(140deg, #eee8fb, #e9efff); padding: 48rpx 46rpx; margin: 4rpx 0 36rpx; overflow: hidden; min-height: 364rpx; box-sizing: border-box; }
.result-cover-heading-lg { font-size: 50rpx; font-weight: 550; letter-spacing: -1rpx; line-height: 1.6; margin-top: 40rpx; }
.result-cover-sub { font-size: 20rpx; color: #8b83a3; margin-top: 20rpx; }
.result-statement { font-size: 28rpx; line-height: 1.9; padding: 0 6rpx; margin-bottom: 40rpx; }
.result-source-icon { width: 24rpx; height: 24rpx; }
.result-source-text { line-height: 1.8; }
.result-tip-copy { margin-top: 18rpx; }
.result-tip-note { margin-top: 22rpx; }
