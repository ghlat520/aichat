%22%20font-family%3D%22PingFang%20SC%2C%20sans-serif%22%3E%3Ctspan%20x%3D%2283.1%22%3E%E6%84%9F%E8%A7%89%28S%29%3C%2Ftspan%3E%3Ctspan%20x%3D%2283.1%22%20dy%3D%2218%22%20font-size%3D%2213%22%20fill%3D%22%237c8db7%22%3E9%E5%88%86%3C%2Ftspan%3E%3C%2Ftext%3E%3C%2Fsvg%3E"); background-size: 100% 100%; background-repeat: no-repeat; margin: 24rpx 0 8rpx; }
.mbti-r-radar-note { text-align: center; font-size: 18rpx; line-height: 1.9; color: #96a2b8; margin: 0 6rpx; }
.mbti-r-note-br, .mbti-r-end-br { display: block; height: 0; }
.mbti-r-card { margin: 0 0 32rpx; padding: 44rpx 36rpx; border: 1rpx solid var(--ui-line, #e9edf5); border-radius: 38rpx; background: #ffffff; }
.mbti-r-card-title { display: inline-block; font-size: 36rpx; font-weight: 550; line-height: 1.6; color: #3c4d6c; border-bottom: 8rpx solid #e9edff; padding: 0 4rpx 4rpx; margin-bottom: 26rpx; }
.mbti-r-card-title::before { content: ''; display: inline-block; width: 18rpx; height: 18rpx; border-radius: 50%; background: #91a0d7; margin-right: 16rpx; box-shadow: 4rpx -4rpx 0 #d8dff5; }
.mbti-r-para { font-size: 28rpx; line-height: 2; color: #687790; overflow-wrap: anywhere; }
.mbti-r-boundary { font-size: 18rpx; color: var(--ui-muted, #778298); line-height: 1.9; text-align: center; margin: 26rpx 10rpx 38rpx; }
.mbti-r-directory { background: #ffffff; border: 1rpx solid var(--ui-line, #e9edf5); border-radius: 30rpx; padding: 34rpx 36rpx; margin-bottom: 32rpx; }
.mbti-r-dir-toggle { display: flex; justify-content: space-between; align-items: center; width: 100%; background: transparent; padding: 0; margin: 0; font-size: 28rpx; color: #6f7e9b; font-weight: 500; line-height: 1.8; }
.mbti-r-dir-toggle::after { border: 0; }
.mbti-r-dir-count { font-size: 20rpx; color: #9aa6ba; font-weight: 400; }
.mbti-r-dir-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx 28rpx; margin-top: 40rpx; }
.mbti-r-dir-link { font-size: 24rpx; line-height: 1.8; color: #7f8eac; }
.mbti-r-section { scroll-margin-top: 32rpx; }
.mbti-r-list { padding-left: 34rpx; margin-top: 26rpx; }
.mbti-r-bullet { font-size: 28rpx; line-height: 1.95; color: #687790; margin-bottom: 20rpx; overflow-wrap: anywhere; }
.mbti-r-bullet::before { content: '·'; color: #a3afd0; margin-right: 8rpx; }
.mbti-r-bullet:last-child { margin-bottom: 0; }
.mbti-r-end { font-size: 18rpx; line-height: 1.9; color: var(--ui-muted, #778298); text-align: center; margin: 0 0 44rpx; }
/* V2：结果页探索双链接（原型 .assessment-result-links）*/
.mbti-r-links { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin: 38rpx 0; }
.mbti-r-link { font-size: 22rpx; line-height: 1.8; padding: 22rpx 14rpx; border: 1rpx solid var(--ui-line, #e9edf5); border-radius: 18rpx; background: #ffffff; color: #8797bb; margin: 0; }
.mbti-r-link::after { border: 0; }
