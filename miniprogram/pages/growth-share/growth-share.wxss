.poster-tabs { display:flex; gap:10rpx; background:#edf1f8; padding:8rpx; border-radius:22rpx; margin:20rpx 0 30rpx; }
.poster-tab { flex:1; font-size:20rpx; padding:18rpx 6rpx; color:#62718a; border-radius:16rpx; background:transparent; line-height:1.5; }
.poster-tab::after { border:0; }
.poster-tab--selected { background:#fff; color:#3155d9; box-shadow:0 4rpx 10rpx #52658212; }
.poster-preview { position:relative; width:100%; padding-top:153.3333%; border-radius:24rpx; overflow:hidden; background:#e8effb; border:1rpx solid #dce5f2; box-sizing:border-box; margin-top:24rpx; }
.poster-image { position:absolute; inset:0; width:100%; height:100%; }
.poster-pending { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; color:#62718a; font-size:14px; }
.poster-preview-note { color:#62718a; font-size:12px; text-align:center; margin:16rpx 0 28rpx; }
.share-flag-group { margin-top:34rpx; }
.share-flag { display:flex; align-items:flex-start; gap:18rpx; font-size:22rpx; line-height:1.9; background:transparent; text-align:left; padding:6rpx 0; width:100%; color:var(--ui-ink); }
.share-flag::after { border:0; }
.share-flag-check { color:var(--ui-brand); }
.poster-canvas { position:fixed; left:-9999rpx; top:0; width:900px; height:1380px; }
.poster-page { padding-bottom:calc(120px + env(safe-area-inset-bottom)); }
.poster-actions { position:fixed; left:0; right:0; bottom:0; z-index:20; padding:12px 28rpx calc(12px + env(safe-area-inset-bottom)); background:#fff; border-top:1px solid #dce5f2; box-sizing:border-box; }
.poster-actions .gk-button-pair { margin:0; }
.poster-actions button { margin-top:0; }
