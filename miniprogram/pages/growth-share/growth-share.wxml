<view class="container gk-screen poster-page">
  <view class="gk-head"><button class="ui-back" bindtap="goBack" aria-label="返回"><view class="ui-icon ui-icon--back"></view></button><view class="gk-head-title">分享我的发现</view><text class="gk-head-tag">自愿分享</text></view>
  <view wx:if="{{reportError}}" id="poster-error" class="gk-notice">{{reportError}}</view>
  <block wx:if="{{poster}}">
    <view wx:if="{{!reportMode}}" class="poster-tabs"><button wx:for="{{tabs}}" wx:key="id" class="poster-tab {{posterKind === item.id ? 'poster-tab--selected' : ''}}" data-kind="{{item.id}}" bindtap="setPosterKind">{{item.label}}</button></view>
    <view id="poster-preview" class="poster-preview" bindtap="previewPoster" role="button" aria-label="放大海报">
      <image wx:if="{{posterImage}}" id="poster-image" class="poster-image" src="{{posterImage}}" mode="aspectFit" aria-label="{{poster.eyebrow}}，{{poster.title}}，含小程序码" />
      <view wx:else class="poster-pending">{{posterSaveState === 'fail' ? '生成失败，请重试' : qrReady ? '正在生成海报…' : '小程序码暂不可用'}}</view>
    </view>
    <view class="poster-preview-note">点击海报可放大查看</view>
    <view class="gk-field"><view class="gk-field-label">海报署名 <text class="gk-field-label-note">选填</text></view><input id="poster-name" class="gk-input" value="{{posterName}}" placeholder="探索中的我" maxlength="16" bindinput="onNameInput" /></view>
    <block wx:if="{{!reportMode}}">
      <view class="gk-field-label">小程序转发入口</view>
      <view class="gk-chips"><button wx:for="{{entryOptions}}" wx:key="*this" class="gk-chip {{shareEntry === item[0] ? 'gk-chip--selected' : ''}}" data-entry="{{item[0]}}" bindtap="setShareEntry">{{item[1]}}</button></view>
    </block>
    <view wx:if="{{showShareFlags}}" class="share-flag-group">
      <button class="share-flag" data-flag="type" bindtap="toggleShareFlag"><text class="share-flag-check">{{shareFlags.type ? '☑' : '☐'}}</text>展示人格偏好</button>
      <button class="share-flag" data-flag="strength" bindtap="toggleShareFlag"><text class="share-flag-check">{{shareFlags.strength ? '☑' : '☐'}}</text>展示优势主题</button>
      <button class="share-flag" data-flag="experience" bindtap="toggleShareFlag"><text class="share-flag-check">{{shareFlags.experience ? '☑' : '☐'}}</text>加入我选择的经历摘要</button>
    </view>
    <view class="poster-actions"><view class="gk-button-pair"><button id="poster-save" class="gk-primary" disabled="{{posterBusy || !qrReady}}" bindtap="savePoster">{{posterSaveState === 'ok' ? '已保存' : '保存海报'}}</button><button id="poster-forward" class="gk-secondary" disabled="{{posterBusy || !qrReady}}" bindtap="sharePoster">转发海报</button></view></view>
    <button id="poster-share-app" class="gk-quiet" open-type="share" disabled="{{posterBusy || !qrReady || !posterImage}}">转发小程序</button>
    <button wx:if="{{!reportMode}}" class="gk-text-link" bindtap="simulateRecipient">预览打开后的页面</button>
    <view class="gk-footer-note">核对内容后，再保存或转发。小程序码进入小程序首页。</view>
    <canvas type="2d" id="poster-canvas" class="poster-canvas"></canvas>
  </block>
</view>
