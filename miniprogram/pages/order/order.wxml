<import src="../../templates/preview.wxml" />
<view id="order-page" class="container ui-tab-page gk-screen">
  <template is="page-head" data="{{title:'订单与售后'}}" />
  <view class="ui-page-lede">付款、报告权益与退款到账分别确认。</view>
  <view wx:if="{{notice}}" class="gk-notice">{{notice}}</view>
  <button class="gk-secondary" loading="{{busy}}" disabled="{{busy}}" bindtap="restoreOrders">微信登录并恢复订单</button>
  <view wx:for="{{orders}}" wx:key="order_id" class="gk-card">
    <button class="gk-text-link" data-id="{{item.order_id}}" bindtap="selectOrder">{{item.label}} · ¥{{item.amount}} · {{item.order_id}}</button>
  </view>
  <button wx:if="{{nextCursor}}" class="gk-quiet" bindtap="moreOrders">更多订单</button>
  <block wx:if="{{hasGrowthOrder}}">
    <view class="gk-between order-head-row"><view class="gk-page-title order-head-title">这笔购买</view><text class="gk-tag">{{statusLabel}}</text></view>
    <view class="gk-card">
      <view class="gk-title-sm">{{productLabel}}</view><view class="gk-tiny order-meta">{{orderId}} · {{date}}</view>
      <view class="gk-divider"></view>
      <view class="gk-price-line"><text>订单金额</text><text>¥{{amount}}</text></view>
      <view class="gk-price-line"><text>报告交付</text><text>{{deliveryText}}</text></view>
      <view class="gk-price-line"><text>已确认退款到账</text><text>¥{{refundAmount}}</text></view>
      <view wx:if="{{linkedBase}}" class="gk-tiny">关联基础订单：{{linkedBase}}</view>
    </view>
    <button class="gk-primary" loading="{{busy}}" disabled="{{busy}}" bindtap="queryOrder">查询原订单与处理进度</button>
    <button wx:if="{{deliveryText === '报告权益有效'}}" class="gk-secondary" bindtap="openReport">打开这笔订单的报告</button>
    <view class="gk-section-title"><view class="gk-section-title-title">登记售后诉求</view></view>
    <view class="gk-chips"><button wx:for="{{reasons}}" wx:key="*this" class="gk-chip {{reason === item ? 'gk-chip--selected' : ''}}" data-reason="{{item}}" bindtap="setReason">{{item}}</button></view>
    <view class="gk-field"><textarea class="gk-textarea" value="{{supportText}}" placeholder="写清问题即可，无需复制全部私人经历。" maxlength="800" bindinput="onSupportInput" /></view>
    <button class="gk-secondary" disabled="{{busy}}" bindtap="submitSupport">登记这笔订单的售后</button>
    <view class="gk-footer-note">登记不等于已提交渠道退款。iOS退款请向App Store申请；其他终端由商家在微信后台处理。两笔购买需分别核实。</view>
  </block>
  <view wx:else class="gk-empty"><view class="gk-empty-title">暂未读取到购买记录</view><view class="gk-empty-text">免费结果仍可查看，可用原微信身份恢复订单。</view></view>
  <button class="gk-secondary" bindtap="goReports">查看我的报告</button>
</view>
