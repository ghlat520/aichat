<view class="container gk-screen">
  <view class="gk-head">
    <button class="ui-back" bindtap="goBack" aria-label="返回"><view class="ui-icon ui-icon--back"></view></button>
    <view class="gk-head-title">个人优势说明书</view>
    <button wx:if="{{state === 'ready'}}" id="preview-poster" class="gk-head-share" bindtap="goShare">生成海报</button>
    <text wx:else class="gk-head-tag">报告预览</text>
  </view>

  <!-- 准备中 / 失败 -->
  <block wx:if="{{state !== 'ready'}}">
    <view class="gk-payment-state">
      <view wx:if="{{state === 'preparing'}}" class="gk-loading-orbit"></view>
      <view wx:else class="gk-state-icon gk-state-icon--failure">!</view>
      <view class="gk-payment-state-title">{{state === 'preparing' ? '正在整理你的说明书' : '这次还没有准备好'}}</view>
      <block wx:if="{{state === 'preparing'}}">
        <view class="gk-payment-state-desc">把测评、经历与目标放在一起。</view>
        <view class="gk-payment-state-desc">准备好后，才会出现购买入口。</view>
      </block>
      <block wx:else>
        <view class="gk-payment-state-desc">你的测评和经历都还在。</view>
        <view class="gk-payment-state-desc">可以重新准备，或先继续查看免费结果。</view>
      </block>
    </view>
    <view class="gk-card">
      <view class="gk-path-step"><view class="gk-step-check">✓</view><text class="gk-small">整理测评与经历</text></view>
      <view class="gk-path-step"><view class="gk-step-check {{state === 'preparing' ? '' : 'gk-step-check--missing'}}">{{state === 'preparing' ? '…' : '○'}}</view><text class="gk-small">完成场景建议与交付检查</text></view>
      <view class="gk-tiny preview-step-note">尚未创建购买订单，不会扣款。</view>
    </view>
    <button wx:if="{{state === 'failed'}}" class="gk-primary" bindtap="retryPrepare">重新准备报告</button>
    <button wx:else class="gk-primary" bindtap="finishPreview">刷新准备状态</button>
    <button class="gk-secondary" bindtap="backToPortrait">先回到免费画像</button>
  </block>

  <!-- 就绪 -->
  <block wx:else>
    <view class="report-book">
      <text class="gk-tag gk-tag--white">个人优势说明书 · 样例预览</text>
      <view class="report-book-title">了解优势，找到方向</view>
      <view class="report-book-owner">看清长处与消耗，找到可以尝试的一步。</view>
      <view class="report-book-decoration"></view>
    </view>

    <view class="gk-card">
      <view class="gk-between">
        <view class="gk-title-sm">内容样例</view>
        <text class="gk-tag gk-tag--aqua">结合经历的样例</text>
      </view>
      <view class="gk-small preview-fragment-copy">内容样例：“{{previewFragment.strength}}”体现在{{previewFragment.description}}阅读时，可对照自己的实际经历。</view>
      <view class="gk-evidence">
        <view class="gk-evidence-label">{{confirmed ? '本人确认的经历 1' : '示例经历 1'}}</view>
        <text>"{{experienceAction}}"</text>
      </view>
      <view class="gk-small">适用场景：{{previewFragment.context}}</view>
      <view class="gk-small">留意盲点：{{previewFragment.boundary}}</view>
    </view>

    <view class="gk-section-title"><view class="gk-section-title-title">报告内容</view></view>
    <view class="gk-card preview-chapter-card">
      <view wx:for="{{chapters}}" wx:key="*this" class="preview-chapter">
        <text class="preview-chapter-num">{{index < 9 ? '0' : ''}}{{index + 1}}</text>
        <text class="preview-chapter-name">{{item}}</text>
        <text wx:if="{{index < 2}}" class="gk-tiny preview-chapter-note">含依据</text>
      </view>
    </view>

    <view class="preview-benefits">
      <view class="preview-benefit"><view class="preview-benefit-strong">看见自己的长处</view>8 章内容，附经历依据</view>
      <view class="preview-benefit"><view class="preview-benefit-strong">对照真实的自己</view>记下不符合的解读</view>
      <view class="preview-benefit"><view class="preview-benefit-strong">试着用进生活</view>可选练习与行动复盘</view>
    </view>

    <view class="gk-purchase-box">
      <view class="gk-between preview-price-row">
        <view>
          <view class="gk-tiny">一次购买，可重复查看</view>
          <view class="gk-price preview-price"><text class="gk-price-currency">¥</text>29.90</view>
        </view>
        <text class="gk-tag gk-tag--aqua">报告已就绪</text>
      </view>
      <button class="gk-primary" bindtap="{{canReadBase ? 'openReport' : 'buyBase'}}">{{canReadBase ? '打开已购报告' : '查看购买内容 · ¥29.90'}}</button>
      <button wx:if="{{canReadBase}}" class="gk-secondary" bindtap="buyBase">核对本次输入的购买状态</button>
      <button class="gk-quiet" bindtap="backToPortrait">继续免费使用</button>
      <view class="gk-between preview-box-links">
        <button class="gk-text-link" bindtap="sampleReport">查看完整样例</button>
        <button class="gk-text-link" bindtap="purchaseInfo">购买与售后说明</button>
      </view>
    </view>
    <view class="gk-footer-note">免费基础结果可继续查看。<text class="preview-br"></text>金额以购买确认页的最新报价为准，当前内容采用报告模板；本机校准与复盘练习不会改写已购报告。付款后可重复查看本次报告。</view>
  </block>
</view>
