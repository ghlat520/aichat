.growth-explore-chip { position: absolute; font-size: 24rpx; letter-spacing: 2rpx; line-height: 1; background: #ffffff9c; border: 1rpx solid #e0e6f8; border-radius: 22rpx; padding: 26rpx 20rpx; font-weight: 500; box-shadow: 0 16rpx 40rpx #96a4d00a; }
.growth-explore-chip:first-child { top: 0; right: -20rpx; transform: rotate(7deg); }
.growth-explore-chip--mid { top: 72rpx; right: 26rpx; transform: rotate(-7deg); color: #87a4ac; background: #edf8f6; }
.growth-explore-chip--low { bottom: 0; right: -22rpx; transform: rotate(7deg); color: #b1a1ca; background: #f4f0fa; }
.gk-test-art--via { background: #e7f3f2; color: #6e9b99; }
.gk-test-art--via .ui-icon { width: 74rpx; height: 74rpx; }
.gk-test-art--cross { background: #eeeffb; color: #8c96c4; }
.gk-test-art--cross .ui-icon { width: 74rpx; height: 74rpx; }

