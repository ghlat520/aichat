.growth-test-card--via { background: #f0f7f2; border-color: #dcebe1; }
.growth-test-card .gk-tags { align-items: center; justify-content: space-between; gap: 6rpx; }
.growth-test-card .gk-tag { padding: 0; background: transparent; font-size: 20rpx; color: var(--ui-brand); }
.growth-test-card .gk-tag--aqua { color: #247b70; }
.growth-test-card .gk-tag--gray { color: var(--ui-muted); font-size: 18rpx; }
.growth-test-card > .gk-chevron { position: absolute; right: 20rpx; top: 20rpx; width: 30rpx; height: 30rpx; }
.growth-test-card--cross { grid-column: 1 / -1; flex-direction: row; align-items: center; gap: 24rpx; padding: 28rpx; border-radius: 26rpx; }
.growth-test-card--cross .growth-tool-art { width: 74rpx; height: 74rpx; flex-shrink: 0; }
.growth-test-card--cross .growth-test-card-name { font-size: 26rpx; margin: 0 0 6rpx; }
.growth-test-card--cross .growth-test-card-desc { font-size: 20rpx; margin: 0; }
.growth-test-card--cross .gk-tags { display: none; }
.growth-test-card--cross > .gk-chevron { position: static; }
#assessment-page .gk-section-title { margin: 28rpx 0 18rpx; }
#assessment-page .gk-head { height: 108rpx; grid-template-columns: 88rpx 1fr 104rpx; gap: 12rpx; }
#assessment-page .gk-head .ui-back { width: 88rpx; height: 88rpx; border: 0; background: transparent; }
#assessment-page .gk-head-tag { border: 0; padding: 0; font-size: 20rpx; }
@media (max-width: 350px) {
  .growth-hero-title { font-size: 50rpx; }
  .growth-hero-art { width: 260rpx; right: -12rpx; }
  .growth-explore-title { font-size: 36rpx; }
  .growth-explore-art { width: 150rpx; }
  .growth-test-card-name { font-size: 28rpx; }
}
