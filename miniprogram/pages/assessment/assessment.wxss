 .growth-tool-art--mbti { background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20160%20112%22%3E%3Cpath%20d%3D%22M80%2056C27%2056%2026%205%2056%207c22%202%2024%2031%2024%2049Z%22%20fill%3D%22%233155d9%22%2F%3E%3Cpath%20d%3D%22M80%2056C80%203%20132%202%20130%2032c-2%2022-32%2024-50%2024Z%22%20fill%3D%22%238fa6ef%22%2F%3E%3Cpath%20d%3D%22M80%2056c53%200%2054%2051%2024%2049-22-2-24-31-24-49Z%22%20fill%3D%22%23b5d7c6%22%2F%3E%3Cpath%20d%3D%22M80%2056c0%2053-52%2054-50%2024%202-22%2032-24%2050-24Z%22%20fill%3D%22%23eab394%22%2F%3E%3Ccircle%20cx%3D%2280%22%20cy%3D%2256%22%20r%3D%2211%22%20fill%3D%22%23fff%22%2F%3E%3Ccircle%20cx%3D%2280%22%20cy%3D%2256%22%20r%3D%225%22%20fill%3D%22%233155d9%22%2F%3E%3C%2Fsvg%3E"); }
