.reflection-title { font-size: 46rpx; line-height: 1.6; letter-spacing: -1.2rpx; font-weight: 550; margin: 28rpx 0 10rpx; }
.reflection-days { display: flex; gap: 12rpx; justify-content: space-between; margin: 38rpx 0; }
.reflection-day { width: 66rpx; height: 76rpx; border-radius: 16rpx; background: #ffffff; border: 1rpx solid var(--ui-line); display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: #a5afc1; }
.reflection-day--done { background: var(--ui-aqua); color: var(--gk-teal); border-color: #c5e8e1; }
.reflection-action-title { margin: 14rpx 0 10rpx; }
.reflection-saved-banner { background: var(--ui-aqua); color: var(--gk-teal); padding: 22rpx 26rpx; font-size: 22rpx; line-height: 1.8; border-radius: 22rpx; margin: 20rpx 0; }
