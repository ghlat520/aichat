<view id="entry-page" class="ui-tab-page entry-growth">
  <block wx:if="{{panel === 'home'}}">
    <view class="growth-heading"><view><view class="growth-date">{{dateLabel}}</view><view class="growth-main-title">更懂自己，更喜欢自己。</view></view><button class="growth-profile" bindtap="goProfile" aria-label="打开我的空间"><view class="ui-icon ui-icon--user"></view></button></view>
    <view wx:if="{{next}}" class="growth-next growth-next--{{next.tone}}">
      <view class="growth-next-top"><view class="growth-next-copy"><view wx:if="{{next.status}}" class="growth-status">{{next.status}}</view><view wx:for="{{next.title}}" wx:key="*this" class="growth-next-title">{{item}}</view></view><image class="growth-hero-art" src="{{next.art}}" mode="aspectFit" /></view>
      <view class="growth-next-description">{{next.description}}</view><button id="home-practice" class="growth-primary" bindtap="goNext">{{next.action}}</button>
    </view>
    <view class="growth-cycle" aria-label="探索自己，找到线索；觉察开悟，形成理解；自我驱动，尝试一个小改变；用复盘继续认识自己">
      <image class="growth-cycle-connect" src="{{images.cycle}}" mode="scaleToFill" />
      <button id="home-assessment" class="growth-cycle-step growth-cycle-step--0" bindtap="goAssessment" aria-label="探索自己，找到线索，打开自测"><view class="growth-cycle-icon"><view class="ui-icon ui-icon--test"></view></view><view class="growth-cycle-title">探索自己</view><view class="growth-cycle-note">找到线索</view></button>
      <button id="home-diary" class="growth-cycle-step growth-cycle-step--1" bindtap="goDiary" aria-label="觉察开悟，形成理解，写三行觉察"><view class="growth-cycle-icon growth-cycle-icon--mint"><view class="ui-icon ui-icon--leaf"></view></view><view class="growth-cycle-title">觉察开悟</view><view class="growth-cycle-note">形成理解</view></button>
      <button id="home-venting" class="growth-cycle-step growth-cycle-step--2" bindtap="goVenting" aria-label="自我驱动，尝试一个小改变"><view class="growth-cycle-icon growth-cycle-icon--peach"><view class="ui-icon ui-icon--chat"></view></view><view class="growth-cycle-title">自我驱动</view><view class="growth-cycle-note">尝试一个<view>小改变</view></view></button>
      <button id="home-review" class="growth-cycle-step growth-cycle-step--3" bindtap="goReview" aria-label="用复盘继续认识自己"><view class="growth-cycle-icon growth-cycle-icon--review"><image src="{{images.review}}" mode="aspectFit" /></view><view class="growth-cycle-title">用复盘</view><view class="growth-cycle-note">继续认识自己</view></button>
    </view>
    <button id="home-zodiac" class="growth-zodiac" bindtap="goZodiac"><view class="growth-zodiac-copy"><view class="growth-zodiac-title">12 星座图鉴</view><view class="growth-zodiac-note">{{zodiacViewed ? '从' + selectedSign.name + '出发，探索自己的另一面。' : '从性格到事业，读读自己的另一面。'}}</view><view class="growth-zodiac-link">翻开星座图鉴 <view class="ui-icon ui-icon--next"></view></view></view><image src="{{selectedSign.glyph}}" mode="aspectFit" /></button>
    <view wx:if="{{recent}}" class="growth-recent"><view class="growth-section-head"><view>那些更懂自己的时刻</view><button bindtap="goJournal">回看全部日记</button></view><button id="home-recent-diary" class="growth-recent-entry" bindtap="goRecent"><view class="growth-date">{{recent.dateLabel}}</view><view class="growth-recent-text">{{recent.excerpt}}</view><view wx:if="{{recent.inspiration}}" class="growth-recent-source">{{recent.inspiration.source}}</view></button></view>
    <view wx:if="{{error}}" id="entry-config-error" class="growth-service-note">在线服务暂不可用，三行觉察与微行动可继续体验。</view>
  </block>
  <block wx:else>
    <view class="growth-page-head"><button bindtap="closeZodiac" aria-label="返回首页"><view class="ui-icon ui-icon--back"></view></button><view>12 星座图鉴</view><text>自我探索</text></view>
    <view class="zodiac-reading-top"><text class="zodiac-reading-kicker">性格、事业、金钱与相处方式</text><button id="zodiac-picker" class="zodiac-picker" bindtap="toggleZodiacSelector" aria-expanded="{{zodiacSelectorOpen}}">{{zodiacSelectorOpen ? '收起星盘' : '切换星座'}}<view class="ui-icon ui-icon--next zodiac-picker-chevron"></view></button></view>
    <view wx:if="{{zodiacSelectorOpen}}" id="zodiac-selector" class="zodiac-selector">
      <view class="zodiac-orbit"><view class="zodiac-ring"></view><button wx:for="{{signs}}" wx:key="id" id="zodiac-{{item.id}}" class="zodiac-choice {{zodiacId === item.id ? 'zodiac-choice--active' : ''}}" style="left:{{item.left}}%;top:{{item.top}}%;border-color:{{zodiacId === item.id ? item.accent : 'transparent'}};background:{{zodiacId === item.id ? item.wash : '#f6f8fc'}};" data-id="{{item.id}}" bindtap="selectSign" aria-label="{{item.name}}，{{zodiacId === item.id ? '已选择' : '未选择'}}"><image class="zodiac-choice-glyph" src="{{item.glyph}}" mode="aspectFit" /><view>{{item.name}}</view></button><view class="zodiac-center" style="background:{{selectedSign.wash}};color:{{selectedSign.accent}};"><image class="zodiac-center-glyph" src="{{selectedSign.glyph}}" mode="aspectFit" /><view>{{selectedSign.name}}</view><text class="zodiac-center-latin">{{selectedSign.latin}}</text></view></view>
    </view>
    <swiper id="zodiac-carousel" class="zodiac-carousel" circular="{{true}}" current="{{zodiacIndex}}" previous-margin="10rpx" next-margin="10rpx" duration="220" bindchange="onZodiacSwipe">
      <swiper-item wx:for="{{signs}}" wx:key="id"><view class="zodiac-profile-card {{item.id === zodiacId ? 'zodiac-profile-card--active' : ''}}" style="background:{{item.wash}};color:{{item.accent}};"><view class="zodiac-profile-copy"><view class="zodiac-profile-name">{{item.name}}</view><view class="zodiac-profile-meta">{{item.latin}} / {{item.family}}</view><view class="zodiac-profile-headline">{{item.headline}}</view><view class="zodiac-profile-words"><text wx:for="{{item.words}}" wx:for-item="word" wx:key="*this">{{word}}</text></view></view><image class="zodiac-portrait" src="{{item.portrait}}" mode="aspectFit" /></view></swiper-item>
    </swiper>
    <view class="zodiac-navigation"><button id="zodiac-prev" class="zodiac-nav-button" data-step="-1" bindtap="stepZodiac" aria-label="上一个星座"><view class="ui-icon ui-icon--back"></view></button><text id="zodiac-position" class="zodiac-position">{{zodiacIndex + 1}} / 12</text><button id="zodiac-next" class="zodiac-nav-button" data-step="1" bindtap="stepZodiac" aria-label="下一个星座"><view class="ui-icon ui-icon--next"></view></button></view>
    <view id="zodiac-personality" class="zodiac-personality"><view class="zodiac-chapter-label"><image class="zodiac-chapter-icon" src="{{chapterIcons.personality}}" mode="aspectFit" /><view class="zodiac-chapter-name">性格</view></view><view class="zodiac-topic-title">{{selectedSign.personality.title}}</view><view class="zodiac-reading-copy">{{selectedSign.personality.body}}</view><view class="zodiac-character-sides"><view class="zodiac-character-side"><view class="zodiac-side-label">容易看见的优点</view><view class="zodiac-side-title">{{selectedSign.strength.title}}</view><view class="zodiac-side-copy">{{selectedSign.strength.body}}</view></view><view class="zodiac-character-side zodiac-character-side--second"><view class="zodiac-side-label">值得留意的一面</view><view class="zodiac-side-title">{{selectedSign.blindspot.title}}</view><view class="zodiac-side-copy">{{selectedSign.blindspot.body}}</view></view></view></view>
    <view id="zodiac-career" class="zodiac-topic zodiac-topic--career"><view class="zodiac-chapter-label"><image class="zodiac-chapter-icon" src="{{chapterIcons.career}}" mode="aspectFit" /><view class="zodiac-chapter-name">事业</view></view><view class="zodiac-topic-title">{{selectedSign.career.title}}</view><view class="zodiac-reading-copy">{{selectedSign.career.body}}</view><view class="zodiac-scenes"><text wx:for="{{selectedSign.career.scenes}}" wx:key="*this" class="zodiac-scene">{{item}}</text></view></view>
    <view id="zodiac-money" class="zodiac-topic zodiac-topic--money"><view class="zodiac-chapter-label"><image class="zodiac-chapter-icon" src="{{chapterIcons.money}}" mode="aspectFit" /><view class="zodiac-chapter-name">财运与金钱观</view></view><view class="zodiac-topic-title">{{selectedSign.money.title}}</view><view class="zodiac-reading-copy">{{selectedSign.money.body}}</view></view>
    <view id="zodiac-traits" class="zodiac-traits"><view class="zodiac-traits-heading">四项特质</view><view class="zodiac-traits-note">看看带领、相处、行动与创造的方式。</view><view class="zodiac-traits-grid"><view wx:for="{{selectedSign.traits}}" wx:key="id" id="zodiac-trait-{{item.id}}" class="zodiac-trait {{index % 2 ? 'zodiac-trait--right' : ''}} {{index > 1 ? 'zodiac-trait--bottom' : ''}}"><view class="zodiac-trait-label"><image class="zodiac-trait-icon" src="{{item.icon}}" mode="aspectFit" /><text class="zodiac-trait-name">{{item.label}}</text></view><view class="zodiac-trait-meaning">{{item.meaning}}</view><view class="zodiac-trait-style">{{item.style}}</view><view class="zodiac-trait-copy">{{item.body}}</view></view></view></view>
    <view class="zodiac-awareness"><view class="zodiac-awareness-title">写下你的共鸣</view><view class="zodiac-question">{{selectedSign.question}}</view><view class="zodiac-observation">{{selectedSign.note}}</view><button id="zodiac-write" class="growth-primary" bindtap="writeFromSign">带着这个问题写日记</button></view><view class="zodiac-footnote">星座文化的常见解读，供生活观察。个人表现以真实经历为准。</view>
  </block>
</view>
