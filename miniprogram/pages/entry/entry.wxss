/* 方案 A：清爽探索。首页局部 token，不改变其他页面主题。 */
.entry-page {
  --home-ink: var(--ui-ink);
  --home-muted: var(--ui-muted);
  --home-brand: var(--ui-brand);
  --home-paper: #ffffff;
  --home-canvas: var(--ui-canvas);
  --home-line: var(--ui-line);
  --home-blue: var(--ui-blue);
  --home-pink: var(--ui-pink);
  --home-aqua: var(--ui-aqua);
  min-height: 100vh;
  color: var(--home-ink);
  background: var(--home-canvas);
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  line-height: 1.6;
}

.entry-sky { padding: 36rpx 36rpx 8rpx; }
.entry-sky--home { display: block; padding: 24rpx 40rpx 0; }
.entry-brand { display: flex; align-items: center; }
.entry-brand-mark { width: 54rpx; height: 54rpx; border-radius: 18rpx; background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2032%2032%22%3E%3Crect%20width%3D%2232%22%20height%3D%2232%22%20rx%3D%2210%22%20fill%3D%22%233155d9%22%2F%3E%3Cpath%20d%3D%22M8%2019v-6a6%206%200%200%201%206-6h7v6a6%206%200%200%201-6%206H8Z%22%20fill%3D%22white%22%2F%3E%3Cpath%20d%3D%22M24%2013v6a6%206%200%200%201-6%206h-7v-6a6%206%200%200%201%206-6h7Z%22%20fill%3D%22%23a9d8cb%22%2F%3E%3Cpath%20d%3D%22M11%2021%2021%2011%22%20stroke%3D%22%233155d9%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%2F%3E%3C%2Fsvg%3E"); background-size: contain; font-size: 0; flex-shrink: 0; }
.entry-brand-name { margin-left: 17rpx; font-size: 29rpx; font-weight: 600; }
.entry-brand-note { margin-left: 17rpx; font-size: 20rpx; color: var(--home-muted); }
.entry-brand-tag {
  margin-left: auto; padding: 6rpx 13rpx; border: 1rpx solid #dce3f3;
  border-radius: 9rpx; font-size: 19rpx; color: var(--home-brand); background: #ffffff80;
}
.entry-loading-card { margin: 52rpx 36rpx; padding: 36rpx; border-radius: 26rpx; background: var(--home-paper); text-align: center; }
.entry-gate-shell { padding: 28rpx 36rpx 68rpx; }
.entry-gate-hero { padding: 22rpx 3rpx 32rpx; }
.entry-eyebrow { font-size: 22rpx; color: var(--home-brand); }
.entry-gate-title { margin-top: 18rpx; font-size: 45rpx; font-weight: 600; line-height: 1.5; letter-spacing: -1rpx; }
.entry-gate-copy { margin-top: 15rpx; font-size: 25rpx; color: var(--home-muted); line-height: 1.8; }
.entry-consent-card { display: flex; align-items: flex-start; padding: 28rpx; border-color: var(--home-line); box-shadow: none; }
.entry-consent-icon {
  flex-shrink: 0; display: flex; align-items: center; justify-content: center;
  width: 74rpx; height: 74rpx; color: var(--home-brand); background: var(--home-blue);
  border-radius: 24rpx; font-size: 24rpx; font-weight: 600;
}
.entry-consent-content { flex: 1; min-width: 0; margin-left: 22rpx; }
.entry-page .aichat-title { color: var(--home-ink); font-size: 30rpx; font-weight: 600; }
.entry-page .aichat-muted { color: var(--home-muted); font-size: 23rpx; }
.entry-ai { color: var(--home-muted); font-size: 25rpx; line-height: 1.8; margin-bottom: 12rpx; }
.entry-safety-note { font-size: 24rpx; box-shadow: none; }
.entry-safety-title { font-size: 27rpx; font-weight: 600; margin-bottom: 7rpx; }
.entry-check { margin: 30rpx 0 20rpx; padding: 23rpx; background: #ffffffb8; border-radius: 22rpx; }
.entry-check-label { display: flex; align-items: center; font-size: 25rpx; }
.entry-check-copy { margin-left: 12rpx; }
.entry-page .aichat-btn { border-radius: 24rpx; background: var(--home-brand); box-shadow: none; font-size: 27rpx; font-weight: 500; }
.entry-page .entry-agree--disabled { background: #cbd3ed; color: #ffffff; }
.entry-page .aichat-btn--ghost { background: var(--home-paper); color: var(--home-brand); border-color: #dbe2f3; }

.home-shell { padding: 44rpx 40rpx 0; }
.home-welcome { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; padding-bottom: 42rpx; }
.home-greeting { font-size: 39rpx; font-weight: 600; line-height: 1.5; letter-spacing: -1rpx; }
.home-greeting-note { margin-top: 7rpx; color: var(--home-muted); font-size: 21rpx; }
.entry-page .home-boundary-shortcut {
  flex-shrink: 0; display: flex; align-items: center; justify-content: center;
  width: 77rpx; height: 77rpx; margin: 0; padding: 0; border: 3rpx solid var(--home-paper);
  border-radius: 50%; background: #fff8ed; color: #c89c67; font-size: 22rpx;
}
.home-prompt {
  display: flex; align-items: center; gap: 17rpx; width: 100%; box-sizing: border-box;
  margin: 33rpx 0 27rpx; padding: 23rpx 25rpx; text-align: left; line-height: 1.6;
  color: #8793a9; background: #ffffffbd; border: 1rpx solid var(--home-paper); border-radius: 23rpx; font-size: 23rpx;
}
.home-boundary-shortcut::after, .home-prompt::after, .home-mood-chip::after,
.home-tool::after, .home-hero-card::after, .home-featured-test::after,
.home-inline-action::after, .home-tab::after { border: 0; }
/* 覆盖 style v2 的 button:not([size='mini']) 默认宽度。 */
.entry-page .home-prompt, .entry-page .home-hero-card,
.entry-page .home-featured-test, .entry-page .aichat-btn { width: 100%; }
.entry-page .home-prompt, .entry-page .home-hero-card,
.entry-page .home-featured-test, .entry-page .home-mood-chip { font-weight: 400; }
.entry-page .home-inline-action { width: auto; }
.home-prompt, .home-tool, .home-mood-chip, .home-hero-card,
.home-featured-test, .home-inline-action, .home-tab { font-weight: 400; }
.home-prompt:active, .home-featured-test:active { background: #f1f4ff; }
.home-prompt .home-line-icon { width: 33rpx; height: 33rpx; }
.home-mood-card { padding: 29rpx 24rpx 23rpx; border-radius: 37rpx; background: var(--home-paper); box-shadow: 0 8rpx 35rpx #7a8dba06; }
.home-mood-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.home-mood-title { font-size: 24rpx; font-weight: 600; }
.home-mood-caption { flex-shrink: 0; font-size: 18rpx; color: var(--home-muted); }
.home-mood-options { display: flex; justify-content: space-between; gap: 4rpx; margin-top: 23rpx; }
.home-mood-chip {
  display: flex; flex-direction: column; align-items: center; flex: 1; min-width: 0;
  margin: 0; padding: 8rpx 0; border-radius: 18rpx; background: transparent;
  font-size: 18rpx; line-height: 1.5; color: var(--home-muted); white-space: nowrap;
}
.home-mood-chip--active { background: var(--home-blue); color: #475ba9; }
.home-mood-face { position: relative; width: 58rpx; height: 58rpx; margin-bottom: 11rpx; border-radius: 50%; background: #fff3d9; color: #bb8a35; }
.home-face--steady { background: #e1f3ec; color: #54917c; }
.home-face--tangled { background: #e8e6fc; color: #8e85bc; }
.home-face--low { background: #e0ecfa; color: #7c9ac1; }
.home-face--overwhelmed { background: #f9e6ec; color: #bd8199; }
.home-face-eye { position: absolute; top: 22rpx; width: 4rpx; height: 5rpx; background: currentColor; border-radius: 50%; }
.home-face-eye--left { left: 17rpx; }
.home-face-eye--right { right: 17rpx; }
.home-face-mouth { position: absolute; bottom: 14rpx; left: 20rpx; width: 18rpx; height: 9rpx; border-bottom: 3rpx solid currentColor; border-radius: 0 0 20rpx 20rpx; }
.home-face--steady .home-face-eye { height: 3rpx; border-radius: 3rpx; }
.home-face--tangled .home-face-mouth { height: 1rpx; bottom: 16rpx; border-radius: 0; }
.home-face--low .home-face-mouth, .home-face--overwhelmed .home-face-mouth { border-bottom: 0; border-top: 3rpx solid currentColor; border-radius: 20rpx 20rpx 0 0; bottom: 10rpx; }
.home-mood-current { margin-top: 17rpx; font-size: 20rpx; color: var(--home-brand); line-height: 1.7; }
.home-tool-grid { display: flex; justify-content: space-between; gap: 14rpx; padding: 32rpx 0 42rpx; }
.home-tool { display: flex; flex: 1; flex-direction: column; align-items: center; min-width: 0; width: auto; margin: 0; padding: 4rpx 0; background: transparent; line-height: 1.5; }
.home-tool:active { opacity: .7; }
.home-tool-icon { display: flex; align-items: center; justify-content: center; width: 90rpx; height: 90rpx; margin-bottom: 11rpx; border-radius: 30rpx; }
.home-tool-icon--blue { background: var(--home-blue); }
.home-tool-icon--pink { background: var(--home-pink); }
.home-tool-icon--aqua { background: var(--home-aqua); }
.home-tool-name { font-size: 24rpx; font-weight: 600; }
.home-tool-note { margin-top: 5rpx; font-size: 18rpx; font-weight: 400; color: var(--home-muted); white-space: nowrap; }
.home-line-icon { flex-shrink: 0; width: 44rpx; height: 44rpx; background-position: center; background-repeat: no-repeat; background-size: contain; }

.home-hero-card { position: relative; overflow: hidden; box-sizing: border-box; width: 100%; min-height: 374rpx; margin: 0; padding: 40rpx; border-radius: 38rpx; text-align: left; line-height: 1.6; background: var(--home-blue); }
.home-hero-card:active { opacity: .85; }
.home-hero-copy { position: relative; z-index: 1; width: 424rpx; }
.home-eyebrow { display: inline-block; padding: 6rpx 12rpx; font-size: 18rpx; color: #6775b1; background: #ffffff80; border: 1rpx solid #ffffffbd; border-radius: 10rpx; }
.home-hero-title { margin-top: 20rpx; font-size: 46rpx; font-weight: 600; line-height: 1.5; letter-spacing: -1rpx; }
.home-hero-subtitle { margin-top: 16rpx; color: #6d7f9b; font-size: 20rpx; }
.home-hero-action { display: inline-flex; align-items: center; gap: 10rpx; margin-top: 26rpx; color: #fff; background: var(--home-brand); padding: 14rpx 22rpx; border-radius: 18rpx; font-size: 22rpx; }
.home-hero-chevron { font-size: 30rpx; line-height: 1; }
.home-companion { position: absolute; right: -12rpx; bottom: 2rpx; width: 290rpx; height: 312rpx; background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20200%20200%22%3E%3Cellipse%20cx%3D%22110%22%20cy%3D%22180%22%20rx%3D%2267%22%20ry%3D%228%22%20fill%3D%22%23d8e1f5%22%2F%3E%3Cg%20transform%3D%22rotate%2812%20120%20110%29%22%3E%3Crect%20x%3D%2269%22%20y%3D%2242%22%20width%3D%2296%22%20height%3D%22129%22%20rx%3D%2215%22%20fill%3D%22%233155d9%22%2F%3E%3Cpath%20d%3D%22M90%2063h40m-40%2012h54%22%20stroke%3D%22%23a9baf3%22%20stroke-width%3D%223%22%20stroke-linecap%3D%22round%22%2F%3E%3C%2Fg%3E%3Cg%20transform%3D%22rotate%28-10%2094%20116%29%22%3E%3Crect%20x%3D%2240%22%20y%3D%2270%22%20width%3D%22101%22%20height%3D%22104%22%20rx%3D%2213%22%20fill%3D%22%23fff%22%20stroke%3D%22%23c9d5f0%22%20stroke-width%3D%221.5%22%2F%3E%3Ccircle%20cx%3D%2263%22%20cy%3D%2294%22%20r%3D%229%22%20fill%3D%22%23d9e8d6%22%2F%3E%3Cpath%20d%3D%22M58%20120h64m-64%2012h48m-48%2012h35%22%20stroke%3D%22%239bafcf%22%20stroke-width%3D%223%22%20stroke-linecap%3D%22round%22%2F%3E%3Cpath%20d%3D%22m105%20150%205%205%2010-11%22%20stroke%3D%22%23247b70%22%20stroke-width%3D%223%22%20fill%3D%22none%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fg%3E%3Ccircle%20cx%3D%22161%22%20cy%3D%2261%22%20r%3D%2216%22%20fill%3D%22%23eab394%22%2F%3E%3C%2Fsvg%3E"); background-size: contain; background-repeat: no-repeat; }

.home-section-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin: 42rpx 0 23rpx; }
.home-section-title { color: var(--home-ink); font-size: 30rpx; font-weight: 600; }
.home-section-note { font-size: 19rpx; color: var(--home-muted); }
.home-featured-test { display: flex; align-items: center; gap: 23rpx; box-sizing: border-box; width: 100%; margin: 0; padding: 25rpx; border: 1rpx solid var(--home-line); border-radius: 30rpx; background: var(--home-paper); text-align: left; line-height: 1.6; }
.home-test-art { flex-shrink: 0; position: relative; display: flex; align-items: center; justify-content: center; width: 122rpx; height: 126rpx; border-radius: 25rpx; background: var(--home-pink); }
.home-test-heart { position: relative; width: 48rpx; height: 48rpx; background: #e7a2ba; transform: rotate(-45deg); border-radius: 7rpx; }
.home-test-heart::before, .home-test-heart::after { content: ""; position: absolute; width: 48rpx; height: 48rpx; background: #e7a2ba; border-radius: 50%; }
.home-test-heart::before { top: -24rpx; }
.home-test-heart::after { left: 24rpx; }
.home-test-copy { flex: 1; min-width: 0; }
.home-test-title { font-size: 24rpx; font-weight: 600; }
.home-test-note { margin-top: 7rpx; font-size: 20rpx; color: var(--home-muted); }
.home-test-tag { display: inline-block; margin-top: 12rpx; padding: 3rpx 9rpx; font-size: 17rpx; color: #917883; background: #faf2f4; border-radius: 6rpx; }
.home-chevron { margin-left: auto; flex-shrink: 0; font-size: 37rpx; color: #bbc4d4; }
.home-assets-card { margin-top: 39rpx; padding: 29rpx; border: 1rpx solid var(--home-line); border-radius: 30rpx; background: var(--home-paper); }
.home-assets-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.home-assets-privacy { font-size: 18rpx; color: var(--home-muted); white-space: nowrap; }
.home-profile-result, .home-profile-empty { margin-top: 23rpx; padding-top: 23rpx; border-top: 1rpx solid var(--home-line); }
.home-profile-empty { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.home-profile-empty-copy { flex: 1; min-width: 0; }
.home-profile-badge { display: inline-block; padding: 4rpx 11rpx; background: var(--home-blue); border-radius: 7rpx; color: var(--home-brand); font-size: 19rpx; }
.home-profile-title { margin-top: 11rpx; font-size: 27rpx; font-weight: 600; line-height: 1.6; }
.home-profile-empty .home-profile-title { margin-top: 0; }
.home-profile-copy { margin-top: 8rpx; color: var(--home-muted); font-size: 22rpx; line-height: 1.8; }
.home-profile-actions { display: flex; gap: 15rpx; margin-top: 22rpx; flex-wrap: wrap; }
.home-inline-action { width: auto; margin: 0; padding: 13rpx 22rpx; border: 1rpx solid #dce3f3; border-radius: 18rpx; font-size: 22rpx; line-height: 1.5; color: var(--home-brand); background: var(--home-paper); }
.home-inline-action--primary { color: var(--home-paper); border-color: var(--home-brand); background: var(--home-brand); }
.home-profile-empty .home-inline-action { flex-shrink: 0; }
.home-task-status { display: flex; align-items: center; gap: 11rpx; margin-top: 22rpx; color: #6b819a; font-size: 21rpx; }
.home-task-dot { flex-shrink: 0; width: 11rpx; height: 11rpx; border-radius: 50%; background: #80b8aa; }
.home-boundary-card { display: flex; align-items: flex-start; gap: 17rpx; padding: 30rpx 4rpx 0; }
.home-boundary-mark { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 55rpx; height: 55rpx; border: 1rpx solid #dde4f1; border-radius: 18rpx; font-size: 18rpx; color: #8896b6; }
.home-boundary-copy { flex: 1; min-width: 0; }
.home-boundary-title { font-size: 23rpx; font-weight: 500; color: #718099; }
.home-boundary-note { margin-top: 7rpx; font-size: 20rpx; line-height: 1.8; color: var(--home-muted); }
.home-privacy-line { margin-top: 10rpx; font-size: 20rpx; color: #8492ad; }
.home-tabbar-safe-space { height: calc(160rpx + env(safe-area-inset-bottom)); }
/* V1.2：留给自己的发现入口（自我探索结果与个人报告） */
.home-growth-entry { display: flex; align-items: center; gap: 22rpx; width: 100%; box-sizing: border-box; padding: 28rpx 24rpx; margin: 20rpx 0; background: #ffffff; border: 1rpx solid #eef1f8; border-radius: 30rpx; text-align: left; line-height: 1.6; }
.home-growth-entry::after { border: 0; }
.home-growth-entry-title { font-size: 26rpx; font-weight: 500; margin-bottom: 6rpx; }
/* V1.2 严格对齐：留给自己的发现（原型 recent-row：透明底 + 下边框，非白卡） */
.home-section-link { font-size: 22rpx; color: var(--ui-brand); background: transparent; padding: 0; line-height: 1.6; }
.home-section-link::after { border: 0; }
.home-recent-row { display: flex; align-items: center; gap: 22rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--ui-line); text-align: left; width: 100%; background: transparent; line-height: 1.6; font-size: inherit; }
.home-recent-row::after { border: 0; }
.home-recent-name { font-size: 24rpx; font-weight: 500; margin-bottom: 8rpx; color: var(--ui-ink); }

.entry-brand-note { display: none; }
.entry-brand-name { margin-left: 14rpx; font-size: 26rpx; }
/* Daily growth homepage, matched to the current A prototype. */
page{background:#f6f8fc;color:#192a43}.entry-growth{padding:32rpx 36rpx 190rpx;min-height:100vh;box-sizing:border-box}.growth-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:30rpx}.growth-date{font-size:24rpx;line-height:1.6;color:#62718a}.growth-main-title{font-size:44rpx;line-height:1.5;font-weight:600;margin-top:8rpx;letter-spacing:-1rpx}.growth-profile{width:88rpx;height:88rpx;min-width:88rpx;border-radius:50%;padding:22rpx;background:#fbe9df;color:#3155d9;display:flex;align-items:center;justify-content:center}.growth-profile .ui-icon{width:42rpx;height:42rpx}.growth-next{padding:36rpx;border-radius:44rpx;background:#e8eeff}.growth-next--mint{background:#e2f3ed}.growth-next--peach{background:#fbe9df}.growth-next-top{display:flex;align-items:center;gap:16rpx}.growth-next-copy{flex:1;min-width:0}.growth-status{font-size:24rpx;line-height:1.6;color:#435b9b;margin-bottom:14rpx}.growth-next-title{font-size:44rpx;font-weight:600;line-height:1.45;letter-spacing:-1rpx}.growth-hero-art{width:224rpx;height:240rpx;flex-shrink:0}.growth-next-description{font-size:26rpx;line-height:1.85;color:#4f6084;margin-top:16rpx;word-break:break-all}.growth-primary{width:100%;min-height:96rpx;padding:23rpx 20rpx;border-radius:24rpx;background:#3155d9;color:#fff;font-size:28rpx;font-weight:550;line-height:1.7;margin:28rpx 0 0}.growth-primary::after,.growth-cycle button::after,.growth-zodiac::after,.growth-profile::after,.growth-section-head button::after,.growth-recent-entry::after{border:0}.growth-cycle{position:relative;display:flex;align-items:flex-start;min-height:268rpx;margin:36rpx 0 24rpx}.growth-cycle-connect{position:absolute;top:0;left:0;width:100%;height:160rpx;pointer-events:none}.growth-cycle-step{width:25%;min-width:0;min-height:216rpx;display:flex;flex-direction:column;align-items:center;gap:12rpx;padding:0;background:transparent;overflow:visible;line-height:1.5}.growth-cycle-step--0{transform:translateY(48rpx)}.growth-cycle-step--1{transform:translateY(32rpx)}.growth-cycle-step--2{transform:translateY(16rpx)}.growth-cycle-icon{width:84rpx;height:84rpx;box-sizing:border-box;border:8rpx solid #f6f8fc;background:#e8eeff;color:#3155d9;border-radius:50%;display:flex;align-items:center;justify-content:center}.growth-cycle-icon .ui-icon,.growth-cycle-icon image{width:44rpx;height:44rpx}.growth-cycle-icon--mint{background:#e2f3ed;color:#247b70}.growth-cycle-icon--peach{background:#fbe9df;color:#a5653d}.growth-cycle-icon--review{background:#eee5fa;color:#7454ad}.growth-cycle-title{font-size:28rpx;font-weight:600;white-space:nowrap}.growth-cycle-note{font-size:24rpx;color:#62718a;letter-spacing:-.5rpx;line-height:1.6}.growth-zodiac{width:100%;display:flex;align-items:center;gap:24rpx;text-align:left;padding:32rpx;border-radius:38rpx;background:#fbe9df;color:#192a43}.growth-zodiac-copy{flex:1;min-width:0}.growth-zodiac-title{font-size:36rpx;line-height:1.5;font-weight:600}.growth-zodiac-note{font-size:26rpx;line-height:1.8;color:#805d4c;margin-top:12rpx}.growth-zodiac-link{display:flex;align-items:center;gap:8rpx;font-size:24rpx;color:#80513c;margin-top:16rpx}.growth-zodiac-link .ui-icon{width:26rpx;height:26rpx}.growth-zodiac>image{width:132rpx;height:144rpx;flex-shrink:0}.growth-recent{margin-top:38rpx}.growth-section-head{display:flex;justify-content:space-between;align-items:center;font-size:32rpx;font-weight:600}.growth-section-head button{font-size:24rpx;color:#3155d9;min-height:88rpx;padding:0;background:transparent;line-height:88rpx;margin:0}.growth-recent-entry{width:100%;padding:32rpx;text-align:left;background:#fff;border:1rpx solid #e2e8f1;border-radius:32rpx}.growth-recent-text{font-size:28rpx;line-height:1.9;margin-top:15rpx;word-break:break-all}.growth-recent-source{font-size:24rpx;color:#247b70;margin-top:18rpx}.growth-service-note{font-size:24rpx;line-height:1.8;color:#62718a;margin-top:30rpx}.growth-page-head{display:flex;align-items:center;gap:12rpx;min-height:100rpx;font-size:32rpx;font-weight:600}.growth-page-head button{width:88rpx;height:88rpx;padding:22rpx;margin:0;background:transparent}.growth-page-head text{font-size:24rpx;color:#62718a;margin-left:auto;font-weight:400}
/* Star-sign dossiers: one illustrated deck, then readable topic cards. */
.growth-page-head button::after { border:0; }
.zodiac-reading-top { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-bottom:24rpx; }
.zodiac-reading-kicker { font-size:12px; line-height:1.7; color:#62718a; }
.zodiac-picker { display:flex; align-items:center; gap:4rpx; margin:0; min-height:88rpx; padding:12rpx 0 12rpx 12rpx; color:#3155d9; background:transparent; font-size:13px; white-space:nowrap; line-height:1.6; }
.zodiac-picker::after { border:0; }
.zodiac-picker-chevron { width:28rpx; height:28rpx; transform:rotate(90deg); }
.zodiac-selector { margin-bottom:36rpx; border-bottom:1rpx solid #dce5f2; }
.zodiac-orbit { width:100%; height:620rpx; position:relative; margin:12rpx auto 28rpx; }
.zodiac-ring { position:absolute; left:13%; right:13%; top:13%; bottom:13%; border:1rpx solid #d5deee; border-radius:50%; }
.zodiac-choice { position:absolute; width:96rpx; height:96rpx; transform:translate(-50%,-50%); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2rpx; padding:0; border:2rpx solid transparent; border-radius:50%; font-size:12px; line-height:1.5; overflow:visible; }
.zodiac-choice--active { border-width:4rpx; font-weight:600; }
.zodiac-choice::after { border:0; }
.zodiac-choice-glyph { width:42rpx; height:42rpx; flex-shrink:0; }
.zodiac-center { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:232rpx; height:232rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-direction:column; font-size:18px; font-weight:600; gap:5rpx; }
.zodiac-center-glyph { width:98rpx; height:98rpx; }
.zodiac-center-latin { font-size:12px; font-weight:400; }
.zodiac-carousel { height:396rpx; min-height:220px; margin:0 -10rpx; }
.zodiac-profile-card { position:relative; min-height:370rpx; box-sizing:border-box; overflow:hidden; border-radius:42rpx; margin:6rpx 8rpx 0; padding:38rpx 36rpx; transform:scale(.96); opacity:.6; transition:transform 180ms,opacity 180ms; }
.zodiac-profile-card--active { transform:scale(1); opacity:1; }
.zodiac-profile-copy { position:relative; z-index:1; max-width:65%; }
.zodiac-profile-name { font-size:26px; line-height:1.3; font-weight:600; letter-spacing:-.5px; color:#25354b; }
.zodiac-profile-meta { font-size:12px; line-height:1.6; margin-top:10rpx; }
.zodiac-profile-headline { white-space:pre-line; font-size:18px; line-height:1.6; font-weight:500; color:#25354b; margin-top:28rpx; }
.zodiac-profile-words { display:flex; flex-wrap:wrap; gap:18rpx; font-size:12px; line-height:1.6; margin-top:22rpx; }
.zodiac-portrait { position:absolute; width:47%; height:300rpx; right:-6rpx; top:38rpx; }
.zodiac-navigation { display:flex; align-items:center; justify-content:center; gap:52rpx; margin:0 0 36rpx; }
.zodiac-nav-button { display:flex; align-items:center; justify-content:center; margin:0; width:88rpx; height:88rpx; padding:24rpx; background:transparent; color:#3155d9; }
.zodiac-nav-button::after { border:0; }
.zodiac-nav-button .ui-icon { width:36rpx; height:36rpx; }
.zodiac-position { min-width:94rpx; text-align:center; color:#62718a; font-size:13px; line-height:1.6; }
.zodiac-personality { padding:38rpx; border:1rpx solid #e2e8f1; background:#fff; border-radius:38rpx; }
.zodiac-chapter-label { display:flex; align-items:center; gap:16rpx; }
.zodiac-chapter-icon { width:46rpx; height:46rpx; flex-shrink:0; }
.zodiac-chapter-name { font-size:17px; line-height:1.5; font-weight:600; color:#25354b; }
.zodiac-topic-title { font-size:19px; line-height:1.6; font-weight:500; color:#25354b; margin-top:28rpx; }
.zodiac-reading-copy { font-size:14px; line-height:1.9; color:#62718a; margin-top:18rpx; }
.zodiac-character-sides { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:28rpx; margin-top:36rpx; padding-top:32rpx; border-top:1rpx dashed #cdd8e8; }
.zodiac-character-side--second { border-left:1rpx dashed #cdd8e8; padding-left:28rpx; }
.zodiac-side-label { font-size:12px; line-height:1.7; color:#718099; margin-bottom:18rpx; }
.zodiac-side-title { font-size:14px; line-height:1.7; font-weight:500; color:#25354b; }
.zodiac-side-copy { margin-top:14rpx; font-size:14px; line-height:1.85; color:#62718a; }
.zodiac-topic { padding:44rpx 6rpx; }
.zodiac-topic--money { padding:38rpx; border-radius:38rpx; background:#fbe9df; margin-bottom:50rpx; }
.zodiac-scenes { display:flex; flex-wrap:wrap; gap:14rpx; margin-top:28rpx; }
.zodiac-scene { font-size:12px; line-height:1.7; padding:8rpx 16rpx; background:#e8eeff; color:#3155d9; border-radius:10rpx; }
.zodiac-traits-heading { font-size:19px; line-height:1.6; font-weight:500; color:#25354b; }
.zodiac-traits-note { margin-top:10rpx; color:#62718a; font-size:13px; line-height:1.8; }
.zodiac-traits-grid { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); border:1rpx solid #e2e8f1; border-radius:38rpx; overflow:hidden; background:#fff; margin-top:30rpx; }
.zodiac-trait { padding:32rpx 28rpx; }
.zodiac-trait--right { border-left:1rpx solid #e2e8f1; }
.zodiac-trait--bottom { border-top:1rpx solid #e2e8f1; }
.zodiac-trait-label { display:flex; align-items:center; gap:12rpx; }
.zodiac-trait-icon { width:44rpx; height:44rpx; flex-shrink:0; }
.zodiac-trait-name { font-size:14px; font-weight:500; color:#25354b; }
.zodiac-trait-meaning { margin-top:14rpx; font-size:12px; line-height:1.6; color:#718099; }
.zodiac-trait-style { font-size:17px; font-weight:500; line-height:1.6; color:#25354b; margin-top:22rpx; }
.zodiac-trait-copy { font-size:14px; line-height:1.85; color:#62718a; margin-top:14rpx; }
.zodiac-awareness { margin-top:48rpx; padding:38rpx; border-radius:38rpx; background:#e2f3ed; }
.zodiac-awareness-title { font-size:17px; line-height:1.6; font-weight:500; color:#247b70; margin-bottom:26rpx; }
.zodiac-question { font-size:17px; line-height:1.8; font-weight:500; color:#25354b; }
.zodiac-observation { font-size:14px; line-height:1.85; color:#62718a; margin:22rpx 0 34rpx; }
.zodiac-footnote { font-size:12px; line-height:1.8; color:#718099; margin-top:28rpx; }
