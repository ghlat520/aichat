.report-empty-icon { display: flex; justify-content: center; margin-bottom: 36rpx; }
.report-empty-icon .ui-icon { width: 68rpx; height: 68rpx; color: #b5bfdd; }
.report-br { display: block; height: 0; }
.report-header { text-align: center; padding: 32rpx 20rpx 20rpx; }
.report-header-title { font-size: 54rpx; letter-spacing: -1.6rpx; font-weight: 550; line-height: 1.55; margin-top: 24rpx; }
.report-header-meta { margin-top: 24rpx; line-height: 1.9; }
.report-revision-title { font-weight: 550; display: block; margin-bottom: 8rpx; }
.report-actions { display: flex; gap: 14rpx; margin: 30rpx 0; }
.report-action-btn { font-size: 22rpx; display: flex; justify-content: center; align-items: center; gap: 12rpx; padding: 20rpx 16rpx; border: 1rpx solid #dde3f1; border-radius: 18rpx; flex: 1; background: #ffffff; color: var(--ui-brand); line-height: 1.5; }
.report-action-btn::after { border: 0; }
.report-action-btn .ui-icon { width: 30rpx; height: 30rpx; }
.report-paper { background: #ffffff; border: 1rpx solid var(--ui-line); border-radius: 32rpx; padding: 42rpx 40rpx; margin: 36rpx 0; }
.report-section { margin: 50rpx 0; }
.report-section:first-child { margin-top: 4rpx; }
.report-section-title { font-size: 30rpx; font-weight: 600; line-height: 1.7; padding-left: 20rpx; border-left: 6rpx solid #a8b4e8; margin-bottom: 24rpx; }
.report-section-text { font-size: 24rpx; line-height: 2; color: #68778f; }
.report-sub-title { font-size: 24rpx; font-weight: 550; margin: 32rpx 0 14rpx; color: var(--ui-ink); }
.report-source { font-size: 20rpx; color: #96a0b4; line-height: 1.9; margin-top: 22rpx; }
.report-source-tags { margin-top: 24rpx; }
.report-strength { margin-top: 10rpx; }
.report-strength-title { font-size: 24rpx; font-weight: 550; margin: 32rpx 0 14rpx; color: var(--ui-ink); }
.report-observe { font-size: 22rpx; line-height: 1.9; color: #879891; margin-top: 16rpx; }
.report-action-card { padding: 28rpx; background: #f3f7f7; border-radius: 20rpx; margin: 26rpx 0; }
.report-action-card .report-sub-title { margin-top: 0; }
.report-action-select { font-size: 20rpx; color: var(--gk-teal); margin-top: 20rpx; padding: 8rpx 0; background: transparent; text-align: left; }
.report-action-select::after { border: 0; }
.report-service { background: #f0edfa; border-radius: 28rpx; padding: 32rpx; margin: 32rpx 0; font-size: 22rpx; line-height: 1.9; color: #8a7da6; }
.report-service-title { font-weight: 550; font-size: 26rpx; color: #766795; }
.report-service-copy { margin-top: 16rpx; }
.report-career-link { display: flex; align-items: center; gap: 22rpx; padding: 33rpx 3rpx; border-bottom: 1rpx solid var(--ui-line); background: transparent; text-align: left; font-size: 25rpx; line-height: 1.6; width: 100%; }
.report-career-link::after { border: 0; }
.report-version-line { font-size: 20rpx; color: var(--ui-muted); line-height: 1.9; margin-top: 26rpx; text-align: center; }
