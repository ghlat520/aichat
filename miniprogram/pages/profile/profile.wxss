.profile-space .ui-page-head-tag { font-size: 12px; border: 0; padding: 0; color: var(--ui-muted); }
.profile-overview { padding: 40rpx; border: 1rpx solid var(--ui-line); border-radius: 48rpx; background: var(--ui-paper); }
.profile-person { display: flex; align-items: center; justify-content: space-between; gap: 32rpx; }
.profile-greeting { color: var(--ui-muted); font-size: max(26rpx, 13px); line-height: 1.6; }
.profile-name { margin-top: 4rpx; font-size: max(48rpx, 24px); line-height: 1.4; font-weight: 600; letter-spacing: -1rpx; }
.profile-portrait { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 120rpx; height: 120rpx; border-radius: 40rpx; background: var(--ui-blue); }
.profile-portrait .ui-icon { width: 60rpx; height: 60rpx; }
.profile-intro { margin-top: 24rpx; font-size: max(26rpx, 13px); line-height: 1.7; color: var(--ui-muted); }
.profile-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 40rpx; padding-top: 36rpx; border-top: 1rpx solid var(--ui-line); }
.profile-stat { text-align: center; min-width: 0; font-size: max(24rpx, 12px); line-height: 1.6; color: var(--ui-muted); }
.profile-stat + .profile-stat { border-left: 1rpx solid var(--ui-line); }
.profile-stat-value { display: block; margin-bottom: 10rpx; font-size: max(48rpx, 24px); line-height: 1.35; color: var(--ui-ink); font-weight: 600; font-variant-numeric: tabular-nums; }
.profile-next { display: block; width: 100%; box-sizing: border-box; margin: 32rpx 0 0; padding: 36rpx 40rpx; text-align: left; border-radius: 40rpx; background: var(--ui-blue); line-height: 1.6; }
.profile-next::after, .profile-link::after, .profile-identity-action::after { border: 0; }
.profile-next-title { color: var(--ui-ink); font-size: max(32rpx, 16px); font-weight: 600; line-height: 1.6; }
.profile-next-copy { margin-top: 12rpx; color: var(--ui-ink); font-size: max(26rpx, 13px); line-height: 1.75; }
.profile-next-action { display: flex; align-items: center; gap: 12rpx; margin-top: 26rpx; color: var(--ui-brand); font-size: max(28rpx, 14px); font-weight: 600; line-height: 1.6; }
.profile-next-action .ui-icon { width: 34rpx; height: 34rpx; }
.profile-section-title { margin: 48rpx 4rpx 20rpx; color: var(--ui-ink); font-size: max(28rpx, 14px); font-weight: 600; line-height: 1.6; }
.profile-links { border: 1rpx solid var(--ui-line); border-radius: 40rpx; background: var(--ui-paper); }
.profile-link { display: flex; align-items: center; gap: 24rpx; box-sizing: border-box; width: 100%; min-height: 152rpx; margin: 0; padding: 28rpx 32rpx; text-align: left; border-radius: 0; background: transparent; line-height: 1.6; }
.profile-link:first-child { border-radius: 40rpx 40rpx 0 0; }
.profile-link:last-child { border-radius: 0 0 40rpx 40rpx; }
.profile-link + .profile-link { border-top: 1rpx solid var(--ui-line); }
.profile-link-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 80rpx; height: 80rpx; border-radius: 24rpx; background: var(--ui-blue); }
.profile-link-icon--aqua { background: var(--ui-aqua); }
.profile-link-icon--pink { background: var(--ui-pink); }
.profile-link-icon .ui-icon { width: 42rpx; height: 42rpx; }
.profile-link-copy { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.profile-link-title { color: var(--ui-ink); font-size: max(30rpx, 15px); font-weight: 500; line-height: 1.6; }
.profile-link-note { margin-top: 4rpx; color: var(--ui-muted); font-size: max(24rpx, 12px); line-height: 1.6; }
.profile-chevron { flex-shrink: 0; width: 36rpx; height: 36rpx; }
.profile-link:active { background: var(--ui-canvas); }
.profile-next:active { background: var(--ui-aqua); }
.profile-identity-card { margin-top: 24rpx; padding: 32rpx; border: 1rpx solid var(--ui-line); border-radius: 40rpx; background: var(--ui-paper); }
.profile-identity-header { display: flex; align-items: center; gap: 20rpx; }
.profile-identity-action { display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-sizing: border-box; min-height: 44px; margin: 0; padding: 20rpx 24rpx; border-radius: 24rpx; font-size: max(26rpx, 13px); line-height: 1.6; color: var(--ui-brand); background: var(--ui-blue); }
.profile-identity-action[disabled] { opacity: .5; }
.profile-identity-action--quiet { color: var(--ui-muted); background: var(--ui-canvas); }
.profile-identity-hint { margin-top: 20rpx; color: var(--ui-muted); font-size: max(24rpx, 12px); line-height: 1.8; }
.profile-space .gk-notice { color: var(--ui-ink); font-size: max(24rpx, 12px); }
.profile-footer { margin: 48rpx 0 4rpx; text-align: center; color: var(--ui-muted); font-size: max(24rpx, 12px); line-height: 1.8; }
