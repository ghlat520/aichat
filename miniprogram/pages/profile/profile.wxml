<import src="../../templates/preview.wxml" />
<view id="profile-page" class="container ui-tab-page gk-screen">
  <template is="page-head" data="{{title:'我的空间'}}" />
  <view class="profile-welcome"><view class="profile-avatar"><view class="ui-icon ui-icon--user"></view></view><view><view class="profile-name">你好，探索中的你</view><view class="aichat-muted">每一次认真面对，都算数。</view></view></view>
  <view class="profile-stats">
    <view class="profile-stat"><view class="profile-stat-value">{{growthStats.results}}</view><text>自测结果</text></view>
    <view class="profile-stat"><view class="profile-stat-value">{{growthStats.reports}}</view><text>个人报告</text></view>
    <view class="profile-stat"><view class="profile-stat-value">{{growthStats.reflections}}</view><text>行动复盘</text></view>
  </view>
  <view class="gk-card profile-growth-card">
    <view class="gk-between">
      <view class="gk-title-sm">我的探索，还在继续</view>
      <text class="gk-tag">按自己的节奏</text>
    </view>
    <view class="gk-small profile-growth-copy">{{growthStats.reports ? '一份说明书，一个小练习。带回生活，再看看有哪些变化。' : '了解偏好只是开始，真实经历会让你看见更丰富的自己。'}}</view>
    <button class="gk-primary" bindtap="{{growthStats.reports ? 'openReport' : 'goDiscover'}}">{{growthStats.reports ? '打开我的说明书' : '继续认识自己'}}</button>
  </view>
  <button class="ui-menu-row" bindtap="goGrowthReports"><view class="ui-icon ui-icon--cards"></view><text>我的报告</text><text class="profile-menu-note">免费结果与已购报告</text><view class="ui-icon ui-icon--next ui-chevron"></view></button>
  <button class="ui-menu-row" bindtap="goGrowthReflection"><view class="ui-icon ui-icon--leaf"></view><text>我的成长记录</text><text class="profile-menu-note">{{growthStats.reflections ? '已有一次行动复盘' : '小练习与复盘'}}</text><view class="ui-icon ui-icon--next ui-chevron"></view></button>
  <button class="ui-menu-row" bindtap="goOrder"><view class="ui-icon ui-icon--test"></view><text>订单与售后</text><text class="profile-menu-note">购买和处理进度</text><view class="ui-icon ui-icon--next ui-chevron"></view></button>
  <button class="ui-menu-row" bindtap="goCards"><view class="ui-icon ui-icon--cards"></view><text>我的关系清晰卡</text><text class="profile-menu-note">原有关系整理</text><view class="ui-icon ui-icon--next ui-chevron"></view></button>
  <button class="ui-menu-row" bindtap="goSavedVoices"><view class="ui-icon ui-icon--heart"></view><text>留给自己的力量</text><text class="profile-menu-note">{{growthStats.savedVoices ? growthStats.savedVoices + ' 句已留好' : '给正在努力的你'}}</text><view class="ui-icon ui-icon--next ui-chevron"></view></button>
  <button class="ui-menu-row" bindtap="goPrivacy"><view class="ui-icon ui-icon--shield"></view><text>隐私与数据</text><view class="ui-icon ui-icon--next ui-chevron"></view></button>
  <view class="ui-quiet-note profile-footer">认识自己，也给自己留一点空间。</view>
</view>
