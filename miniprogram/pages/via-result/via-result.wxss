/* VIA 结果（2026-11-03 原型 V2 via-result 屏，px×2→rpx）*/
.vr-note { background: #ffffff; border: 1rpx solid var(--ui-line, #e9edf5); border-radius: 26rpx; padding: 28rpx; font-size: 22rpx; color: #7c89a2; line-height: 1.95; margin: 36rpx 0; }
.vr-note--example { background: #f0eefb; border-color: #e3def5; color: #9082a8; }
.vr-heading { text-align: center; margin: 40rpx 0 56rpx; }
.vr-heading-icon { display: flex; align-items: center; justify-content: center; width: 120rpx; height: 120rpx; margin: 0 auto 36rpx; border-radius: 40rpx; background: #e7f3f2; color: #83a8a3; }
.vr-heading-icon .ui-icon { width: 58rpx; height: 58rpx; }
.vr-heading-title { font-size: 52rpx; line-height: 1.65; letter-spacing: -1rpx; font-weight: 550; color: #3f506c; }
.vr-heading-sub { font-size: 22rpx; line-height: 1.9; color: #95a1b7; margin-top: 22rpx; }
.vr-section-heading { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; margin: 56rpx 0 32rpx; }
.vr-section-title { font-size: 30rpx; font-weight: 550; line-height: 1.8; }
.vr-section-note { font-size: 18rpx; color: #9aa5b8; }
.vr-top-card { display: flex; align-items: flex-start; gap: 24rpx; background: #ffffff; border: 1rpx solid var(--ui-line, #e9edf5); border-radius: 30rpx; padding: 34rpx 28rpx; margin-bottom: 22rpx; }
.vr-rank { width: 54rpx; height: 54rpx; border-radius: 18rpx; background: #eaf0fb; color: #7f90bf; font-size: 24rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.vr-top-main { flex: 1; min-width: 0; }
.vr-top-name { font-size: 34rpx; font-weight: 550; line-height: 1.7; }
.vr-top-en { display: block; font-size: 18rpx; color: #99a5b8; line-height: 1.8; overflow-wrap: anywhere; }
.vr-top-desc { font-size: 22rpx; color: #8290a7; line-height: 1.9; margin-top: 14rpx; overflow-wrap: anywhere; }
.vr-top-score { font-size: 38rpx; font-weight: 500; line-height: 1.5; color: #7a8db8; }
.vr-top-score-unit { font-size: 18rpx; font-weight: 400; }
.vr-small-note { font-size: 20rpx; color: #98a4b7; line-height: 1.95; margin: 30rpx 0; }
.vr-ranking-card { padding: 42rpx 34rpx; background: #ffffff; border: 1rpx solid var(--ui-line, #e9edf5); border-radius: 34rpx; margin: 50rpx 0; }
.vr-ranking-title { font-size: 32rpx; font-weight: 550; margin-bottom: 32rpx; }
.vr-rank-row { display: flex; gap: 26rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--ui-line, #e9edf5); }
.vr-rank-row:last-child { border-bottom: 0; padding-bottom: 4rpx; }
.vr-rank-no { font-size: 20rpx; line-height: 1.9; color: #a2aec2; min-width: 36rpx; }
.vr-rank-main { flex: 1; min-width: 0; }
.vr-rank-head { display: flex; justify-content: space-between; }
.vr-rank-name { font-size: 26rpx; font-weight: 500; }
.vr-rank-score { font-size: 24rpx; font-weight: 500; color: #7b8cb5; }
.vr-rank-en { display: block; font-size: 18rpx; color: #a1acbd; line-height: 1.8; margin: 10rpx 0 18rpx; overflow-wrap: anywhere; }
.vr-bar { height: 10rpx; background: #edf0f8; border-radius: 16rpx; overflow: hidden; }
.vr-bar-fill { height: 100%; border-radius: 16rpx; background: #b1bddf; }
