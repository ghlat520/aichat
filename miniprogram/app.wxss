/* 与 A 版 preview 共用的视觉规则：浅蓝、淡紫、白色表面。 */
page {
  --ui-ink: #28334b; --ui-muted: #778298; --ui-brand: #6577dc;
  --ui-paper: #ffffff; --ui-canvas: #f7f9fd; --ui-line: #edf0f6;
  --ui-blue: #e7efff; --ui-pink: #fce9ec; --ui-aqua: #dff6f4;
  min-height: 100%; background: var(--ui-canvas); color: var(--ui-ink);
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 26rpx; line-height: 1.7;
}
/* 自定义按钮沿用原型的布局；不继承原生按钮的水平自动外边距。 */
button { margin-left: 0; margin-right: 0; }
.container { min-height: 100vh; box-sizing: border-box; padding: 32rpx 36rpx 72rpx; }
.ui-tab-page { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.aichat-card { position: relative; box-sizing: border-box; background: var(--ui-paper); border: 1rpx solid var(--ui-line); border-radius: 32rpx; padding: 30rpx; margin-bottom: 24rpx; box-shadow: 0 7rpx 24rpx #737da907; }
.page-hero { background: transparent; border: 0; box-shadow: none; padding: 10rpx 0 25rpx; margin-bottom: 16rpx; }
.page-title { color: var(--ui-ink); font-size: 38rpx; font-weight: 600; letter-spacing: -1rpx; line-height: 1.5; margin-bottom: 12rpx; }
.aichat-title { color: var(--ui-ink); font-size: 31rpx; font-weight: 600; margin-bottom: 14rpx; }
.aichat-muted { color: var(--ui-muted); font-size: 23rpx; line-height: 1.8; }
.aichat-label { color: var(--ui-ink); font-size: 25rpx; font-weight: 500; }
.aichat-body { color: #778197; font-size: 25rpx; line-height: 1.9; white-space: pre-wrap; overflow-wrap: anywhere; margin-bottom: 20rpx; }
.aichat-btn { display: block; box-sizing: border-box; background: var(--ui-brand); color: #ffffff; border-radius: 25rpx; padding: 22rpx 26rpx; text-align: center; font-size: 26rpx; font-weight: 500; line-height: 1.5; margin-top: 20rpx; border: 0; }
.container .aichat-btn { width: 100%; }
.aichat-btn::after { border: 0; }
.aichat-btn[disabled] { background: #cbd3ed; color: #ffffff; }
.aichat-btn--ghost { background: var(--ui-paper); color: var(--ui-brand); border: 1rpx solid #dce3f3; }
.aichat-warning { box-sizing: border-box; background: #fff5f4; color: #a27575; border: 1rpx solid #f4e1e4; padding: 21rpx 24rpx; border-radius: 22rpx; font-size: 24rpx; line-height: 1.8; margin-bottom: 22rpx; }
.aichat-row,.aichat-actions { display: flex; align-items: center; gap: 17rpx; }
.aichat-row { justify-content: space-between; }
.aichat-actions .aichat-btn { flex: 1; min-width: 0; }
.aichat-field { margin-bottom: 29rpx; }
.aichat-input,.aichat-textarea,.aichat-picker { width: 100%; box-sizing: border-box; background: var(--ui-paper); color: var(--ui-ink); border: 1rpx solid #e4e9f3; border-radius: 24rpx; padding: 20rpx 22rpx; margin-top: 14rpx; font-size: 24rpx; line-height: 1.8; }
.aichat-input { height: 84rpx; }
.aichat-textarea { height: 160rpx; min-height: 140rpx; }
.aichat-input:focus,.aichat-textarea:focus { border-color: var(--ui-brand); }
.aichat-picker { position: relative; }
.aichat-picker::after { content: "⌄"; position: absolute; right: 22rpx; color: var(--ui-brand); }
.aichat-chip { display: inline-block; background: #edf1ff; color: var(--ui-brand); border-radius: 12rpx; padding: 7rpx 16rpx; margin: 7rpx 10rpx 0 0; font-size: 22rpx; }
.aichat-option { display: flex; align-items: center; gap: 16rpx; box-sizing: border-box; background: var(--ui-paper); border: 1rpx solid #e4e9f3; border-radius: 26rpx; padding: 27rpx 24rpx; margin-bottom: 20rpx; font-size: 24rpx; }
.aichat-option:active { background: #f0f3ff; border-color: var(--ui-brand); }
.aichat-question-text { font-size: 45rpx; line-height: 1.65; font-weight: 500; letter-spacing: -1rpx; margin: 0 0 48rpx; }
.ui-page-head { display: flex; align-items: center; gap: 20rpx; padding: 9rpx 0 35rpx; }
.ui-page-head .ui-back { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; padding: 0; margin: 0; border-radius: 50%; background: var(--ui-paper); }
.ui-back::after { border: 0; }
.ui-back .ui-icon { width: 32rpx; height: 32rpx; }
.ui-page-head-title { font-size: 32rpx; font-weight: 600; letter-spacing: -.6rpx; }
.ui-page-head-tag { margin-left: auto; padding: 5rpx 10rpx; font-size: 18rpx; color: #7c88a9; border: 1rpx solid #dfe5f0; border-radius: 9rpx; }
.ui-icon,.home-line-icon { flex-shrink: 0; width: 43rpx; height: 43rpx; background-position: center; background-repeat: no-repeat; background-size: contain; }
.ui-companion { position: relative; width: 308rpx; height: 308rpx; background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20200%20200%22%3E%0A%20%20%20%20%20%20%3Cdefs%3E%3ClinearGradient%20id%3D%22orb%22%20x1%3D%220%22%20y1%3D%220%22%20x2%3D%221%22%20y2%3D%221%22%3E%3Cstop%20stop-color%3D%22%23c1d3ff%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23839cec%22%2F%3E%3C%2FlinearGradient%3E%3ClinearGradient%20id%3D%22bubble%22%20x1%3D%220%22%20y1%3D%220%22%20x2%3D%221%22%20y2%3D%221%22%3E%3Cstop%20stop-color%3D%22%23fff%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23e7edff%22%2F%3E%3C%2FlinearGradient%3E%3CradialGradient%20id%3D%22shadow%22%3E%3Cstop%20stop-color%3D%22%239baed7%22%20stop-opacity%3D%22.24%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%239baed7%22%20stop-opacity%3D%220%22%2F%3E%3C%2FradialGradient%3E%3C%2Fdefs%3E%0A%20%20%20%20%20%20%3Cellipse%20cx%3D%22103%22%20cy%3D%22174%22%20rx%3D%2265%22%20ry%3D%2213%22%20fill%3D%22url%28%23shadow%29%22%2F%3E%0A%20%20%20%20%20%20%3Cpath%20d%3D%22M29%20106c-4-29%2024-57%2055-48%2026-29%2070-14%2074%2014%2028%205%2037%2037%2020%2057-10%2016-34%2018-50%2014-18%2020-50%2017-60-3-22%204-40-10-39-34Z%22%20fill%3D%22url%28%23bubble%29%22%20stroke%3D%22%23fff%22%20stroke-width%3D%222%22%2F%3E%0A%20%20%20%20%20%20%3Cpath%20d%3D%22M54%20142c-17-24-6-57%2021-67%2037-15%2074%208%2075%2040%201%2022-13%2039-36%2044l-19%2015%202-14c-16%200-32-5-43-18Z%22%20fill%3D%22url%28%23orb%29%22%2F%3E%0A%20%20%20%20%20%20%3Cellipse%20cx%3D%2279%22%20cy%3D%22116%22%20rx%3D%223.4%22%20ry%3D%224.7%22%20fill%3D%22%235066a0%22%2F%3E%3Cellipse%20cx%3D%22119%22%20cy%3D%22116%22%20rx%3D%223.4%22%20ry%3D%224.7%22%20fill%3D%22%235066a0%22%2F%3E%0A%20%20%20%20%20%20%3Cpath%20d%3D%22M92%20129q7%207%2014%200%22%20fill%3D%22none%22%20stroke%3D%22%235066a0%22%20stroke-width%3D%222.8%22%20stroke-linecap%3D%22round%22%2F%3E%0A%20%20%20%20%20%20%3Cellipse%20cx%3D%2269%22%20cy%3D%22127%22%20rx%3D%228%22%20ry%3D%224.5%22%20fill%3D%22%23e5c5ec%22%20opacity%3D%22.8%22%2F%3E%3Cellipse%20cx%3D%22130%22%20cy%3D%22127%22%20rx%3D%228%22%20ry%3D%224.5%22%20fill%3D%22%23e5c5ec%22%20opacity%3D%22.8%22%2F%3E%0A%20%20%20%20%20%20%3Cpath%20d%3D%22M67%2091q12-11%2025-9%22%20fill%3D%22none%22%20stroke%3D%22white%22%20stroke-opacity%3D%22.55%22%20stroke-width%3D%225%22%20stroke-linecap%3D%22round%22%2F%3E%0A%20%20%20%20%20%20%3Cpath%20d%3D%22M147%2029c-7-8-18%201-11%209l11%2011%2011-11c7-8-4-17-11-9%22%20fill%3D%22%23edb7cf%22%2F%3E%0A%20%20%20%20%20%20%3Cpath%20d%3D%22m39%2040%203%208%208%203-8%203-3%208-3-8-8-3%208-3Zm126%20100%202%206%206%202-6%202-2%206-2-6-6-2%206-2Z%22%20fill%3D%22%23b0bedf%22%2F%3E%0A%20%20%20%20%20%20%3Ccircle%20cx%3D%22172%22%20cy%3D%2275%22%20r%3D%224%22%20fill%3D%22%23b4dedb%22%2F%3E%3Ccircle%20cx%3D%2223%22%20cy%3D%22138%22%20r%3D%223%22%20fill%3D%22%23d6caef%22%2F%3E%0A%20%20%20%20%3C%2Fsvg%3E"); background-position: center; background-repeat: no-repeat; background-size: contain; }
.ui-intro-illustration { height: 325rpx; display: flex; align-items: center; justify-content: center; background: radial-gradient(ellipse,#e6e8ff 0,transparent 70%); margin: 8rpx 0 28rpx; }
.ui-intro-illustration .ui-companion { transform: none; }
.ui-intro-title { font-size: 47rpx; font-weight: 600; line-height: 1.6; text-align: center; letter-spacing: -1.4rpx; margin-bottom: 18rpx; }
.ui-intro-copy { font-size: 23rpx; color: var(--ui-muted); text-align: center; line-height: 1.9; margin: 0 12rpx 40rpx; }
.ui-quiet-note { margin: 25rpx 8rpx; text-align: center; font-size: 20rpx; line-height: 1.9; color: var(--ui-muted); }
.ui-letter { position: relative; border: 1rpx solid var(--ui-line); background: var(--ui-paper); border-radius: 34rpx; padding: 44rpx 39rpx; margin-bottom: 35rpx; box-shadow: 0 12rpx 38rpx #737da908; }
.ui-letter::before { content: ""; position: absolute; top: 0; left: 39rpx; right: 39rpx; height: 7rpx; border-radius: 0 0 10rpx 10rpx; background: linear-gradient(90deg,#a4afee,#afdeda,#f1c5d5); }
.ui-letter-label { display: flex; align-items: center; gap: 10rpx; font-size: 19rpx; color: #8a94ad; letter-spacing: .5rpx; }
.ui-letter-label .ui-icon { width: 28rpx; height: 28rpx; }
.ui-letter-title { font-size: 42rpx; font-weight: 600; line-height: 1.5; margin: 27rpx 0 17rpx; letter-spacing: -.8rpx; }
.ui-letter-sub { color: var(--ui-muted); font-size: 20rpx; line-height: 1.8; border-bottom: 1rpx dashed #e3e8f2; padding-bottom: 31rpx; }
.ui-letter-section { margin-top: 37rpx; }
.ui-letter-heading { display: flex; align-items: center; gap: 12rpx; margin-bottom: 14rpx; font-size: 23rpx; font-weight: 600; }
.ui-letter-bar { width: 7rpx; height: 22rpx; border-radius: 6rpx; background: #6577dc; }
.ui-letter-bar--pink { background: #ca6c88; }
.ui-letter-bar--aqua { background: #258c89; }
.ui-letter-text { font-size: 23rpx; color: #778197; line-height: 1.9; white-space: pre-wrap; overflow-wrap: anywhere; }
.ui-practice-box { padding: 27rpx; margin-top: 39rpx; border-radius: 23rpx; background: #f2f7f8; }
.ui-practice-title { font-size: 23rpx; font-weight: 600; color: #258c89; margin-bottom: 10rpx; }
.ui-practice-copy { font-size: 22rpx; line-height: 1.9; color: #71888f; }
.ui-menu-row { display: flex; align-items: center; gap: 22rpx; box-sizing: border-box; padding: 33rpx 3rpx; margin: 0; border-bottom: 1rpx solid var(--ui-line); background: transparent; text-align: left; font-size: 25rpx; font-weight: 400; line-height: 1.6; }
.container .ui-menu-row { width: 100%; border-radius: 0; }
.ui-menu-row::after { border: 0; }
.ui-menu-row .ui-icon { width: 36rpx; height: 36rpx; }
.ui-menu-row .ui-chevron { margin-left: auto; }
