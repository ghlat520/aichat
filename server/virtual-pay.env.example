# Personal virtual payment. Keep disabled until MP activation and published goods are verified.
AICHAT_VIRTUAL_PAY_ENABLED=false
AICHAT_WECHAT_APP_ID=
AICHAT_WECHAT_APP_SECRET=
AICHAT_VIRTUAL_PAY_OFFER_ID=
AICHAT_VIRTUAL_PAY_APP_KEY=
AICHAT_VIRTUAL_PAY_PUSH_TOKEN=
AICHAT_VIRTUAL_PAY_ENCODING_AES_KEY=

# Report adapter: three distinct published goods, fixed quantity 1, integer fen.
AICHAT_VIRTUAL_PAY_BASE_PRODUCT_ID=
AICHAT_VIRTUAL_PAY_CAREER_PRODUCT_ID=
AICHAT_VIRTUAL_PAY_UPGRADE_PRODUCT_ID=
AICHAT_VIRTUAL_PAY_BASE_PRICE_FEN=2990
AICHAT_VIRTUAL_PAY_CAREER_PRICE_FEN=4990
AICHAT_VIRTUAL_PAY_UPGRADE_PRICE_FEN=2000
AICHAT_VIRTUAL_PAY_QUERY_DELAY_MS=300000

# Database, session signing and envelope encryption use the existing service configuration.
# Fill real keys only in an ignored local environment file or the deployment secret store.
# Isolated automated tests provide fake keys and loopback API replacements themselves.
